{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "outputs": []
    },
    "biome:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@slates-integrations/super-booble-2a#build": {
      "dependsOn": [
        "^build",
        "@slates/oauth-google#build",
        "@slates/super-google-tools#build"
      ],
      "outputs": ["dist/**"]
    }
  }
}
