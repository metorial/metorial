{
  "create_company": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "description": "Company name",
        "type": "string"
      },
      "description": {
        "description": "Short description of the company",
        "type": "string"
      },
      "industry": {
        "description": "Industry sector",
        "type": "string"
      },
      "fundingRaised": {
        "description": "Total funding raised (USD)",
        "type": "string"
      },
      "lastFundingDate": {
        "description": "Most recent funding date (YYYY-MM-DD)",
        "type": "string"
      },
      "foundationYear": {
        "description": "Year the company was founded (YYYY)",
        "type": "string"
      },
      "employeeRange": {
        "description": "Employee count range",
        "type": "string",
        "enum": [
          "1-10",
          "11-50",
          "51-200",
          "201-500",
          "501-1000",
          "1001-5000",
          "5001-10000",
          "10000+"
        ]
      },
      "groupIds": {
        "description": "Group IDs to add the company to",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "emails": {
        "description": "Email addresses (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "phones": {
        "description": "Phone numbers (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "addresses": {
        "description": "Addresses (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "urls": {
        "description": "URLs (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "customFieldValues": {
        "description": "Custom field values keyed by group ID",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "additionalProperties": false
  },
  "create_deal": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "groupId": {
        "type": "string",
        "description": "ID of the group to create the deal in"
      },
      "objectType": {
        "type": "string",
        "description": "Deal object type name (e.g. \"Deals\")"
      },
      "name": {
        "description": "Deal name",
        "type": "string"
      },
      "companyIds": {
        "description": "IDs of companies to associate",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "personIds": {
        "description": "IDs of people to associate",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "customFieldValues": {
        "description": "Custom field values for the deal",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "required": ["groupId", "objectType"],
    "additionalProperties": false
  },
  "create_note": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entityId": {
        "type": "string",
        "description": "ID of the person, company, or deal to attach the note to"
      },
      "content": {
        "type": "string",
        "description": "Note content (plain text or markdown)"
      },
      "visibility": {
        "type": "string",
        "enum": ["public", "private"],
        "description": "Note visibility"
      },
      "parentNoteId": {
        "description": "Parent note ID for creating a reply thread",
        "type": "string"
      }
    },
    "required": ["entityId", "content", "visibility"],
    "additionalProperties": false
  },
  "create_person": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "firstName": {
        "description": "First name of the person",
        "type": "string"
      },
      "lastName": {
        "description": "Last name of the person",
        "type": "string"
      },
      "fullName": {
        "description": "Full name (used if first/last not provided)",
        "type": "string"
      },
      "description": {
        "description": "Short description or bio",
        "type": "string"
      },
      "birthday": {
        "description": "Birthday in YYYY-MM-DD format",
        "type": "string"
      },
      "jobTitle": {
        "description": "Job title or role",
        "type": "string"
      },
      "groupIds": {
        "description": "Group IDs to add the person to",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "companies": {
        "description": "Companies to associate (first is primary)",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "companyId": {
              "description": "Existing company ID",
              "type": "string"
            },
            "companyName": {
              "description": "Company name (creates or links)",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "emails": {
        "description": "Email addresses (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "phones": {
        "description": "Phone numbers (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "addresses": {
        "description": "Addresses (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "urls": {
        "description": "URLs (first is primary)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "customFieldValues": {
        "description": "Custom field values keyed by group ID",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "additionalProperties": false
  },
  "create_reminder": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entityId": {
        "type": "string",
        "description": "ID of the person, company, or deal"
      },
      "name": {
        "type": "string",
        "description": "Reminder title"
      },
      "recurrenceRule": {
        "type": "string",
        "description": "iCalendar recurrence rule (DTSTART + RRULE)"
      },
      "visibility": {
        "type": "string",
        "enum": ["public", "private"],
        "description": "Reminder visibility"
      },
      "assignedUsers": {
        "description": "Users to assign (required for public reminders)",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "userId": {
              "description": "User ID",
              "type": "string"
            },
            "userEmail": {
              "description": "User email",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "required": ["entityId", "name", "recurrenceRule", "visibility"],
    "additionalProperties": false
  },
