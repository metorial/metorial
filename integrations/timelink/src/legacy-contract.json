            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "timeEntries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timeEntryId": {
                  "type": "number",
                  "description": "Unique identifier of the time entry"
                },
                "start": {
                  "type": "string",
                  "description": "Start time of the entry (ISO 8601 format)"
                },
                "end": {
                  "type": "string",
                  "description": "End time of the entry (ISO 8601 format)"
                },
                "description": {
                  "description": "Description of the work performed",
                  "type": "string"
                },
                "clientId": {
                  "description": "ID of the associated client",
                  "type": "number"
                },
                "projectId": {
                  "description": "ID of the associated project",
                  "type": "number"
                },
                "serviceId": {
                  "description": "ID of the associated service",
                  "type": "number"
                },
                "userId": {
                  "description": "ID of the user who created the entry",
                  "type": "number"
                },
                "paid": {
                  "description": "Whether the time entry has been paid",
                  "type": "boolean"
                },
                "billable": {
                  "description": "Whether the time entry is billable",
                  "type": "boolean"
                },
                "externalId": {
                  "description": "External ID for syncing with other systems",
                  "type": "string"
                }
              },
              "required": ["timeEntryId", "start", "end"],
              "additionalProperties": false
            },
            "description": "List of matching time entries"
