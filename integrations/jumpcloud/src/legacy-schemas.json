    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "triggered": {
          "type": "boolean",
          "description": "Whether the command was triggered successfully"
        },
        "triggerName": {
          "type": "string",
          "description": "Trigger name used"
        }
      },
      "required": ["triggered", "triggerName"],
      "additionalProperties": false
    }
  },
  "list_command_results": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "description": "Maximum number of results to return (default 50)",
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "skip": {
          "description": "Number of results to skip for pagination",
          "type": "number",
          "minimum": 0
        },
        "filter": {
          "description": "Filter expression, e.g. \"command:$eq:commandId\"",
          "type": "string"
        },
        "sort": {
          "description": "Sort field, e.g. \"-requestTime\" for most recent first",
          "type": "string"
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resultId": {
                "type": "string",
                "description": "Command result ID"
              },
              "commandId": {
                "type": "string",
                "description": "Command ID"
              },
              "commandName": {
                "type": "string",
                "description": "Command name"
              },
              "systemId": {
                "type": "string",
                "description": "System ID that executed the command"
              },
              "systemName": {
                "description": "System name",
                "type": "string"
              },
              "exitCode": {
                "description": "Exit code (0 = success)",
                "type": "number"
              },
              "output": {
                "description": "Command stdout output",
                "type": "string"
              },
              "error": {
                "description": "Command stderr output",
                "type": "string"
              },
              "requestTime": {
                "type": "string",
                "description": "When the command was requested"
              },
              "responseTime": {
                "description": "When the command completed",
                "type": "string"
              }
            },
            "required": ["resultId", "commandId", "commandName", "systemId", "requestTime"],
            "additionalProperties": false
          },
          "description": "Command execution results"
        },
        "totalCount": {
          "type": "number",
          "description": "Total number of results"
        }
      },
      "required": ["results", "totalCount"],
      "additionalProperties": false
    }
  },
