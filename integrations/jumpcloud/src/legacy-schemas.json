  "query_events": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "service": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Event services to query, e.g. [\"directory\", \"sso\", \"radius\"]"
        },
        "startTime": {
          "type": "string",
          "description": "Start time in RFC3339 UTC format, e.g. \"2024-01-01T00:00:00Z\""
        },
        "endTime": {
          "description": "End time in RFC3339 UTC format",
          "type": "string"
        },
        "limit": {
          "description": "Maximum events to return (default 100, max 10000)",
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "searchAfter": {
          "description": "Cursor from previous response for pagination"
        },
        "searchQuery": {
          "description": "Free-text search query",
          "type": "string"
        }
      },
      "required": ["service", "startTime"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "eventId": {
                "description": "Event ID",
                "type": "string"
              },
              "timestamp": {
                "description": "Event timestamp",
                "type": "string"
              },
              "eventType": {
                "description": "Event type",
                "type": "string"
              },
              "service": {
                "description": "Service category",
                "type": "string"
              },
              "initiatedById": {
                "description": "ID of the initiating actor",
                "type": "string"
              },
              "initiatedByType": {
                "description": "Type of the initiating actor",
                "type": "string"
              },
              "initiatedByEmail": {
                "description": "Email of the initiating actor",
                "type": "string"
              },
              "resourceId": {
                "description": "Affected resource ID",
                "type": "string"
              },
              "resourceType": {
                "description": "Affected resource type",
                "type": "string"
              },
              "organization": {
                "description": "Organization ID",
                "type": "string"
              },
              "rawEvent": {
                "description": "Full raw event data"
              }
            },
            "additionalProperties": false
          },
          "description": "Matching events"
        },
        "searchAfter": {
          "description": "Cursor for fetching next page"
        }
      },
      "required": ["events"],
      "additionalProperties": false
    }
  }
