  "user_actions": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "JumpCloud user ID"
        },
        "action": {
          "type": "string",
          "enum": ["reset_mfa", "unlock"],
          "description": "Action to perform: \"reset_mfa\" clears MFA enrollment, \"unlock\" unlocks a locked account"
        }
      },
      "required": ["userId", "action"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID the action was performed on"
        },
        "action": {
          "type": "string",
          "description": "Action that was performed"
        },
        "success": {
          "type": "boolean",
          "description": "Whether the action was successful"
        }
      },
      "required": ["userId", "action", "success"],
      "additionalProperties": false
    }
  },
