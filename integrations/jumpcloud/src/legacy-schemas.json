          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "skip": {
          "description": "Number of members to skip when listing",
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["action", "groupType", "groupId"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Group ID"
        },
        "action": {
          "type": "string",
          "description": "Action performed"
        },
        "members": {
          "description": "Current group members (returned for list action)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memberId": {
                "type": "string",
                "description": "Member ID"
              },
              "memberType": {
                "type": "string",
                "description": "Member type (user or system)"
              }
            },
            "required": ["memberId", "memberType"],
            "additionalProperties": false
          }
        },
        "success": {
          "type": "boolean",
          "description": "Whether the action succeeded"
        }
      },
      "required": ["groupId", "action", "success"],
      "additionalProperties": false
    }
  },
  "manage_associations": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["add", "remove", "list"],
          "description": "Action to perform"
        },
        "sourceType": {
          "type": "string",
          "enum": ["user", "user_group", "system", "system_group"],
          "description": "Source resource type"
        },
        "sourceId": {
          "type": "string",
          "description": "Source resource ID"
        },
        "targetType": {
          "type": "string",
          "description": "Target resource type (e.g. system_group, application, radius_server, ldap_server)"
        },
        "targetId": {
          "description": "Target resource ID (required for add/remove)",
          "type": "string"
        },
        "sudoEnabled": {
          "description": "Enable sudo access (for user group → system group associations)",
          "type": "boolean"
        },
        "sudoWithoutPassword": {
          "description": "Enable passwordless sudo",
          "type": "boolean"
        },
        "limit": {
          "description": "Max results for list (default 100)",
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "skip": {
          "description": "Skip for pagination when listing",
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["action", "sourceType", "sourceId", "targetType"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "description": "Source resource ID"
        },
        "sourceType": {
          "type": "string",
          "description": "Source resource type"
        },
        "action": {
          "type": "string",
          "description": "Action performed"
        },
        "associations": {
          "description": "Current associations (returned for list action)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "targetId": {
                "type": "string",
                "description": "Target resource ID"
              },
              "targetType": {
                "type": "string",
                "description": "Target resource type"
              }
            },
            "required": ["targetId", "targetType"],
            "additionalProperties": false
          }
        },
        "success": {
          "type": "boolean",
          "description": "Whether the action succeeded"
        }
      },
      "required": ["sourceId", "sourceType", "action", "success"],
      "additionalProperties": false
    }
  },
  "manage_command": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"],
          "description": "Action to perform"
        },
        "commandId": {
          "description": "Command ID (required for update and delete)",
          "type": "string"
        },
        "name": {
          "description": "Command name",
          "type": "string"
        },
        "command": {
          "description": "The command/script to execute",
          "type": "string"
        },
        "commandType": {
          "description": "Command type: \"linux\" (for Mac/Linux) or \"windows\"",
          "type": "string",
          "enum": ["linux", "windows"]
        },
        "user": {
          "description": "User to run the command as (e.g. \"root\", \"000000000000\")",
          "type": "string"
        },
        "sudo": {
          "description": "Run with sudo privileges",
          "type": "boolean"
        },
        "schedule": {
          "description": "Cron schedule expression for scheduled commands",
          "type": "string"
        },
        "scheduleRepeatType": {
          "description": "Schedule repeat type",
          "type": "string"
        },
        "launchType": {
          "description": "How the command is launched",
          "type": "string",
          "enum": ["manual", "trigger", "repeated"]
        },
        "trigger": {
          "description": "Trigger name for webhook-based execution",
          "type": "string"
        },
        "timeout": {
          "description": "Command timeout in seconds",
          "type": "string"
        },
        "shell": {
          "description": "Shell to use (e.g. /bin/bash, /bin/sh, powershell)",
          "type": "string"
        },
        "systems": {
          "description": "Array of system IDs to target",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["action"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "description": "Command ID"
        },
        "name": {
          "type": "string",
          "description": "Command name"
        },
        "command": {
          "type": "string",
          "description": "Command script"
        },
        "commandType": {
          "type": "string",
          "description": "Command type"
        },
        "launchType": {
          "description": "Launch type",
          "type": "string"
        },
        "trigger": {
          "description": "Trigger name",
          "type": "string"
        }
      },
      "required": ["commandId", "name", "command", "commandType"],
      "additionalProperties": false
    }
  },
  "run_command": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "triggerName": {
          "type": "string",
          "description": "The trigger name configured on the command"
        },
        "environmentVars": {
          "description": "Key-value pairs passed as environment variables to the command",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["triggerName"]
