            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "description": "Phone number"
              },
              "type": {
                "description": "Phone type: mobile, home, work, work_mobile, work_fax, other",
                "type": "string"
              }
            },
            "required": ["number"]
          }
        }
      },
      "required": ["action"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID"
        },
        "username": {
          "type": "string",
          "description": "Username"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "firstname": {
          "description": "First name",
          "type": "string"
        },
        "lastname": {
          "description": "Last name",
          "type": "string"
        },
        "displayname": {
          "description": "Display name",
