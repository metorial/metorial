        "location": {
          "description": "Location description",
          "type": "string"
        },
        "alternateEmail": {
          "description": "Alternate email address",
          "type": "string"
        },
        "description": {
          "description": "User description",
          "type": "string"
        },
        "ldapBindingUser": {
          "description": "Whether this is an LDAP binding user",
          "type": "boolean"
        },
        "enableMfa": {
          "description": "Enable user portal multi-factor authentication",
          "type": "boolean"
        },
        "passwordNeverExpires": {
          "description": "Whether the password never expires",
          "type": "boolean"
        },
        "passwordlessSudo": {
          "description": "Whether to allow passwordless sudo",
          "type": "boolean"
        },
        "attributes": {
          "description": "Custom attributes to set on the user",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
