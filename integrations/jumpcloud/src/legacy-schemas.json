{
  "list_users": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "description": "Maximum number of users to return (1-100, default 100)",
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "skip": {
          "description": "Number of users to skip for pagination",
          "type": "number",
          "minimum": 0
        },
        "filter": {
          "description": "Filter expression in JumpCloud format, e.g. \"email:$eq:user@example.com\", \"department:$eq:Engineering\"",
          "type": "string"
        },
        "fields": {
          "description": "Comma-separated list of fields to return, e.g. \"username,email,firstname,lastname\"",
          "type": "string"
        },
        "sort": {
          "description": "Field to sort by. Prefix with \"-\" for descending order, e.g. \"-created\"",
          "type": "string"
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string",
                "description": "Unique user ID"
              },
              "username": {
                "type": "string",
                "description": "Username"
              },
              "email": {
                "type": "string",
                "description": "Primary email address"
              },
              "firstname": {
                "description": "First name",
                "type": "string"
              },
              "lastname": {
                "description": "Last name",
                "type": "string"
              },
              "displayname": {
                "description": "Display name",
                "type": "string"
              },
              "state": {
                "description": "Account state: ACTIVATED, STAGED, or SUSPENDED",
                "type": "string"
              },
              "activated": {
                "description": "Whether the account is activated",
                "type": "boolean"
              },
              "company": {
                "description": "Company name",
                "type": "string"
              },
              "department": {
                "description": "Department",
                "type": "string"
              },
              "jobTitle": {
                "description": "Job title",
                "type": "string"
              },
              "employeeIdentifier": {
                "description": "Employee ID",
                "type": "string"
              },
              "created": {
                "description": "Account creation timestamp",
                "type": "string"
              },
              "suspended": {
                "description": "Whether the account is suspended",
                "type": "boolean"
              }
            },
            "required": ["userId", "username", "email"],
            "additionalProperties": false
          },
          "description": "List of users"
        },
        "totalCount": {
          "type": "number",
          "description": "Total number of users matching the query"
        }
      },
      "required": ["users", "totalCount"],
      "additionalProperties": false
    }
  },
