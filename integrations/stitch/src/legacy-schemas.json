  {
    "key": "get_destination",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "listTypes": {
          "default": false,
          "description": "If true, returns available destination types instead of the current destination",
          "type": "boolean"
        },
        "destinationType": {
          "description": "Get configuration schema for a specific destination type",
          "type": "string"
        }
      },
      "required": ["listTypes"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "destinations": {
          "description": "Current destination(s) configured for the account",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "destinationId": {
                "type": "number",
                "description": "Unique identifier for the destination"
              },
              "type": {
                "type": "string",
                "description": "Destination type (e.g., redshift, bigquery, snowflake, postgres)"
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Display name"
              },
              "properties": {
                "description": "Connection properties (excludes sensitive credentials)",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "createdAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "ISO 8601 creation timestamp"
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "ISO 8601 last updated timestamp"
              },
              "reportCard": {
                "description": "Configuration status report card"
              }
            },
            "required": ["destinationId", "type", "name", "createdAt", "updatedAt"],
            "additionalProperties": false
          }
        },
        "destinationTypes": {
          "description": "Available destination types (when listTypes is true)",
          "type": "array",
          "items": {}
        },
        "destinationTypeDetails": {
          "description": "Configuration details for a specific destination type"
        }
      },
      "additionalProperties": false
    }
  },
