      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "enable", "disable", "delete"],
          "description": "Action to perform"
        },
        "url": {
          "description": "Webhook URL (required for \"create\" action)",
          "type": "string"
        },
        "hookId": {
          "description": "Hook ID (required for enable/disable/delete actions)",
          "type": "number"
        }
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "hookId": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID of the hook"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Webhook URL"
        },
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the hook is disabled"
        },
        "deleted": {
          "description": "Whether the hook was deleted",
          "type": "boolean"
        }
      },
      "required": ["hookId", "url", "disabled"],
      "additionalProperties": false
    }
  },
  {
    "key": "get_source",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "number",
          "description": "ID of the source to retrieve"
        },
        "includeConnectionCheck": {
          "default": false,
          "description": "Whether to also fetch the last connection check result",
          "type": "boolean"
        }
      },
      "required": ["sourceId", "includeConnectionCheck"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "number",
          "description": "Unique identifier for the source"
        },
        "type": {
          "type": "string",
          "description": "Source type"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Display name"
        },
        "properties": {
          "description": "Configuration properties",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 8601 creation timestamp"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 8601 last updated timestamp"
        },
        "pausedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 8601 timestamp if paused"
        },
        "reportCard": {
          "description": "Configuration status report card"
        },
        "lastConnectionCheck": {
          "description": "Last connection check result, if requested"
        }
      },
      "required": ["sourceId", "type", "name", "createdAt", "updatedAt", "pausedAt"],
      "additionalProperties": false
    }
  },
  {
    "key": "list_source_types",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceType": {
          "description": "Specific source type to get details for (e.g., \"platform.hubspot\"). If omitted, lists all available types.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceTypes": {
          "description": "List of all available source types (when no specific type requested)",
          "type": "array",
          "items": {}
        },
        "sourceTypeDetails": {
          "description": "Detailed configuration for a specific source type (when sourceType is provided)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "key": "list_streams",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "number",
          "description": "ID of the source to list streams for"
        }
      },
      "required": ["sourceId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "streamId": {
                "type": "number",
                "description": "Unique stream ID"
              },
              "streamName": {
                "type": "string",
                "description": "Name of the stream/table"
              },
              "tapStreamId": {
                "description": "Tap-level stream identifier",
                "type": "string"
              },
              "selected": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Whether the stream is selected for replication"
              },
              "replicationMethod": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Replication method (INCREMENTAL, FULL_TABLE, LOG_BASED)"
              },
              "replicationKey": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Column used for incremental replication"
              },
              "metadata": {
                "description": "Stream metadata including field-level details"
              }
            },
            "required": [
              "streamId",
              "streamName",
              "selected",
              "replicationMethod",
              "replicationKey"
            ],
            "additionalProperties": false
          },
          "description": "Available streams for the source"
        }
      },
      "required": ["streams"],
      "additionalProperties": false
    }
  },
  {
    "key": "get_stream",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "number",
          "description": "ID of the source"
        },
        "streamId": {
          "type": "number",
          "description": "ID of the stream to retrieve"
        }
      },
      "required": ["sourceId", "streamId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "streamId": {
          "type": "number",
          "description": "Stream ID"
        },
        "streamName": {
          "type": "string",
          "description": "Stream/table name"
        },
        "schema": {
          "description": "JSON Schema describing the stream fields"
        },
        "metadata": {
          "description": "Stream and field-level metadata"
        }
      },
      "required": ["streamId", "streamName"],
      "additionalProperties": false
    }
  },
  {
    "key": "update_stream_selection",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "number",
          "description": "ID of the source"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tapStreamId": {
                "type": "string",
                "description": "Tap-level stream identifier"
              },
              "selected": {
                "description": "Whether to select this stream for replication",
                "type": "boolean"
              },
              "replicationMethod": {
                "description": "Replication method",
                "type": "string",
                "enum": ["INCREMENTAL", "FULL_TABLE", "LOG_BASED"]
              },
              "replicationKey": {
                "description": "Column to use as replication key (for INCREMENTAL)",
                "type": "string"
              },
              "fields": {
                "description": "Field-level selection overrides",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fieldName": {
                      "type": "string",
                      "description": "Name of the field/column"
                    },
                    "selected": {
                      "type": "boolean",
                      "description": "Whether to select this field for replication"
                    }
                  },
                  "required": ["fieldName", "selected"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["tapStreamId"],
            "additionalProperties": false
          },
          "description": "Streams to update with their metadata"
        }
      },
      "required": ["sourceId", "streams"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether the update was successful"
        },
        "updatedStreamCount": {
          "type": "number",
          "description": "Number of streams updated"
        }
      },
      "required": ["success", "updatedStreamCount"],
      "additionalProperties": false
    }
  },
  {
    "key": "create_source",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Source type identifier (e.g., \"platform.hubspot\", \"platform.postgres\")"
        },
        "displayName": {
          "type": "string",
          "description": "Display name for the source"
        },
        "properties": {
          "description": "Connection properties specific to the source type",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["type", "displayName"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "number",
          "description": "ID of the newly created source"
        },
        "type": {
          "type": "string",
          "description": "Source type"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Display name"
        },
        "reportCard": {
          "description": "Configuration status showing next steps"
        }
      },
      "required": ["sourceId", "type", "name"],
      "additionalProperties": false
    }
  }
]
