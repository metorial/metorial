  {
    "key": "push_data",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tableName": {
          "type": "string",
          "description": "Name of the destination table to load data into"
        },
        "schema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "JSON Schema describing the record structure (e.g., {\"properties\": {\"id\": {\"type\": \"integer\"}, \"name\": {\"type\": \"string\"}}})"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "Array of data records to push"
        },
        "keyNames": {
          "description": "Primary key field names for upsert loading. Omit for append-only.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["tableName", "schema", "records"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
