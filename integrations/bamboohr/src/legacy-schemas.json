      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "balances": {
          "description": "Time off balance data by category"
        }
      },
      "required": ["employeeId", "balances"],
      "additionalProperties": false
    }
  },
  "get_time_off_types": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "timeOffTypes": {
          "description": "Map of time off type categories and their types"
        }
      },
      "required": ["timeOffTypes"],
      "additionalProperties": false
    }
  },
  "get_timesheet_entries": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "description": "Start date in YYYY-MM-DD format"
        },
        "end": {
          "type": "string",
          "description": "End date in YYYY-MM-DD format"
        },
        "employeeIds": {
          "description": "Specific employee IDs to filter by",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "timesheetEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "Timesheet hour entries"
        },
        "clockEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "Clock-in/clock-out entries"
        }
      },
      "required": ["timesheetEntries", "clockEntries"],
      "additionalProperties": false
    }
  },
  "clock_in_out": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "action": {
          "type": "string",
          "enum": ["clock_in", "clock_out"],
          "description": "Whether to clock in or clock out"
        },
        "start": {
          "description": "Start time in ISO 8601 format (required for clock_in)",
          "type": "string"
        },
        "timezone": {
          "description": "Timezone for the entry (e.g., \"America/New_York\")",
          "type": "string"
        },
        "note": {
          "description": "Optional note for the clock entry",
          "type": "string"
        },
        "projectId": {
          "description": "Project ID to associate with (clock_in only)",
          "type": "string"
        },
        "taskId": {
          "description": "Task ID to associate with (clock_in only)",
          "type": "string"
        }
      },
      "required": ["employeeId", "action"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "action": {
          "type": "string",
          "description": "The action performed"
        }
      },
      "required": ["employeeId", "action"],
      "additionalProperties": false
    }
  },
  "add_timesheet_entry": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "date": {
          "type": "string",
          "description": "Date for the entry in YYYY-MM-DD format"
        },
        "hours": {
          "type": "number",
          "description": "Number of hours worked"
        },
        "note": {
          "description": "Optional note for the entry",
          "type": "string"
        },
        "projectId": {
          "description": "Project ID to associate with",
          "type": "string"
        },
        "taskId": {
          "description": "Task ID to associate with",
          "type": "string"
        }
      },
      "required": ["employeeId", "date", "hours"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "date": {
          "type": "string",
          "description": "The date of the entry"
        },
        "hours": {
          "type": "number",
          "description": "Hours logged"
        }
      },
      "required": ["employeeId", "date", "hours"],
      "additionalProperties": false
    }
  },
  "generate_custom_report": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of field names to include in the report"
        },
        "format": {
          "default": "JSON",
          "description": "Report output format",
          "type": "string",
          "enum": ["JSON", "CSV", "PDF", "XML"]
        },
        "title": {
          "description": "Title for the report",
          "type": "string"
        },
        "lastChangedSince": {
          "description": "Only include employees changed since this date (YYYY-MM-DDThh:mm:ssZ)",
          "type": "string"
        }
      },
      "required": ["fields", "format"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "description": "Report title",
          "type": "string"
        },
        "format": {
          "type": "string",
          "description": "The format of the report"
        },
        "reportData": {
          "description": "The report data (structure depends on format; JSON returns structured data)"
        }
      },
      "required": ["format", "reportData"],
      "additionalProperties": false
    }
  },
  "get_company_report": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
