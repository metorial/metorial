        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Fields to update as key-value pairs (e.g., { \"jobTitle\": \"Senior Engineer\", \"department\": \"Engineering\" })"
        }
      },
      "required": ["employeeId", "fields"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The updated employee ID"
        },
        "updatedFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of field names that were updated"
        }
      },
