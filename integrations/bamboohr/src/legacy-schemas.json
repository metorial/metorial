          "description": "Table row data"
        }
      },
      "required": ["employeeId", "tableName", "rows"],
      "additionalProperties": false
    }
  },
  "upsert_table_row": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "tableName": {
          "type": "string",
          "description": "The table name (e.g., \"jobInfo\", \"compensation\", \"education\")"
        },
        "rowId": {
          "description": "If updating, the ID of the existing row to update",
          "type": "string"
        },
        "rowData": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Row data as key-value pairs"
        }
      },
      "required": ["employeeId", "tableName", "rowData"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "tableName": {
          "type": "string",
          "description": "The table name"
        },
        "action": {
          "type": "string",
          "description": "Whether the row was \"created\" or \"updated\""
        }
      },
      "required": ["employeeId", "tableName", "action"],
      "additionalProperties": false
    }
  },
  "delete_table_row": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "tableName": {
          "type": "string",
          "description": "The table name"
        },
        "rowId": {
          "type": "string",
          "description": "The ID of the row to delete"
        }
      },
      "required": ["employeeId", "tableName", "rowId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "tableName": {
          "type": "string",
          "description": "The table name"
        },
        "rowId": {
          "type": "string",
          "description": "The deleted row ID"
        }
      },
      "required": ["employeeId", "tableName", "rowId"],
      "additionalProperties": false
    }
  },
  "get_time_off_requests": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "description": "Start date in YYYY-MM-DD format"
        },
        "end": {
          "type": "string",
          "description": "End date in YYYY-MM-DD format"
        },
        "employeeId": {
          "description": "Filter by a specific employee ID",
          "type": "string"
        },
        "status": {
          "description": "Filter by status: \"approved\", \"denied\", \"superceded\", \"requested\", \"canceled\"",
          "type": "string"
        },
        "type": {
          "description": "Filter by time off type ID",
          "type": "string"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "List of time off requests"
        }
      },
      "required": ["requests"],
      "additionalProperties": false
    }
  },
  "create_time_off_request": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "timeOffTypeId": {
          "type": "string",
          "description": "The time off type ID (use Get Time Off Types to find available types)"
        },
        "start": {
          "type": "string",
          "description": "Start date in YYYY-MM-DD format"
        },
        "end": {
          "type": "string",
          "description": "End date in YYYY-MM-DD format"
        },
        "amount": {
          "type": "number",
          "description": "Number of days/hours requested"
        },
        "status": {
          "default": "requested",
          "description": "Initial status for the request",
          "type": "string",
          "enum": ["requested", "approved"]
        },
        "notes": {
          "description": "Notes keyed by date (YYYY-MM-DD)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "dates": {
          "description": "Specific amounts per date (YYYY-MM-DD to hours/days)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": ["employeeId", "timeOffTypeId", "start", "end", "amount", "status"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether the request was created successfully"
        }
      },
      "required": ["success"],
      "additionalProperties": false
    }
  },
  "update_time_off_request_status": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "The time off request ID"
        },
        "status": {
          "type": "string",
          "enum": ["approved", "denied", "canceled"],
          "description": "New status for the request"
        },
        "note": {
          "description": "Optional note explaining the status change",
          "type": "string"
        }
      },
      "required": ["requestId", "status"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "The request ID"
        },
        "status": {
          "type": "string",
          "description": "The new status"
        }
      },
      "required": ["requestId", "status"],
      "additionalProperties": false
    }
  },
  "get_whos_out": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "start": {
          "description": "Start date in YYYY-MM-DD format (defaults to today)",
          "type": "string"
        },
        "end": {
          "description": "End date in YYYY-MM-DD format (defaults to 14 days from start)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "List of who's out entries"
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    }
  },
