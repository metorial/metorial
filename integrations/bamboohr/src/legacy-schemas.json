        "employees": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "List of employee directory entries"
        }
      },
      "required": ["fieldNames", "employees"],
      "additionalProperties": false
    }
  },
  "create_employee": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "Employee first name"
        },
        "lastName": {
          "type": "string",
          "description": "Employee last name"
        },
        "workEmail": {
          "description": "Work email address",
          "type": "string"
        },
        "jobTitle": {
          "description": "Job title",
          "type": "string"
        },
        "department": {
          "description": "Department name",
          "type": "string"
        },
        "division": {
          "description": "Division name",
          "type": "string"
        },
        "location": {
          "description": "Work location",
          "type": "string"
        },
        "hireDate": {
          "description": "Hire date in YYYY-MM-DD format",
          "type": "string"
        },
        "additionalFields": {
          "description": "Additional fields as key-value pairs (field name to value)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["firstName", "lastName"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
