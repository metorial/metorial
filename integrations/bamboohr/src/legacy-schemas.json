{
  "get_employee": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID to look up. Use \"0\" for the current authenticated user."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of field names to include (e.g., [\"firstName\", \"lastName\", \"workEmail\", \"jobTitle\", \"department\", \"hireDate\"])"
        }
      },
      "required": ["employeeId", "fields"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "The requested employee fields and their values"
        }
      },
      "required": ["employeeId", "fields"],
      "additionalProperties": false
    }
  },
  "get_employee_directory": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
