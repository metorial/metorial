      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The ID of the newly created employee"
        },
        "location": {
          "description": "The URL/location of the new employee resource",
          "type": "string"
        }
      },
      "required": ["employeeId"],
      "additionalProperties": false
    }
  },
  "update_employee": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
