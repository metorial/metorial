      "properties": {
        "reportId": {
          "type": "string",
          "description": "The report ID"
        },
        "format": {
          "default": "JSON",
          "description": "Report output format",
          "type": "string",
          "enum": ["JSON", "CSV", "PDF", "XML"]
        },
        "lastChangedSince": {
          "description": "Only include employees changed since this date (YYYY-MM-DDThh:mm:ssZ)",
          "type": "string"
        }
      },
      "required": ["reportId", "format"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "description": "The report ID"
        },
        "format": {
          "type": "string",
          "description": "The format of the report"
        },
        "reportData": {
          "description": "The report data"
        }
      },
      "required": ["reportId", "format", "reportData"],
      "additionalProperties": false
    }
  },
