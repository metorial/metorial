    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "List of goals"
        }
      },
      "required": ["employeeId", "goals"],
      "additionalProperties": false
    }
  },
  "create_goal": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee ID"
        },
        "title": {
          "type": "string",
          "description": "Goal title"
        },
        "description": {
          "description": "Goal description",
          "type": "string"
        },
        "percentComplete": {
          "description": "Initial progress percentage (0-100)",
          "type": "number"
        },
        "dueDate": {
          "description": "Due date in YYYY-MM-DD format",
          "type": "string"
        },
        "sharedWithEmployeeIds": {
          "description": "Employee IDs to share this goal with",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alignsWithOptionId": {
          "description": "ID of the organizational objective to align with",
          "type": "string"
        }
      },
      "required": ["employeeId", "title"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
