{
  "query_documents": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "documentType": {
          "description": "Filter by custom type (e.g., \"blog_post\", \"page\")",
          "type": "string"
        },
        "tags": {
          "description": "Filter by one or more tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "predicates": {
          "description": "Custom Prismic predicates for advanced filtering",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fullTextSearch": {
          "description": "Full-text search query",
          "type": "string"
        },
        "lang": {
          "description": "Language code to filter by (use \"*\" for all languages)",
          "type": "string"
        },
        "orderings": {
          "description": "Ordering expression, e.g., \"[my.blog_post.date desc]\"",
          "type": "string"
        },
        "pageSize": {
          "description": "Number of results per page (1-100, default 20)",
          "type": "number"
        },
        "page": {
          "description": "Page number to retrieve (default 1)",
          "type": "number"
        },
        "after": {
          "description": "Document ID to paginate after (for cursor-based pagination)",
          "type": "string"
        },
        "fetchLinks": {
          "description": "Comma-separated list of fields to fetch from linked documents",
          "type": "string"
        },
        "graphQuery": {
          "description": "GraphQuery string for precise field selection",
          "type": "string"
        },
        "ref": {
          "description": "Content ref to query (defaults to master/published ref)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "page": {
          "type": "number",
          "description": "Current page number"
        },
        "resultsPerPage": {
          "type": "number",
          "description": "Number of results per page"
        },
        "totalResults": {
          "type": "number",
          "description": "Total number of matching documents"
        },
        "totalPages": {
          "type": "number",
          "description": "Total number of pages"
        },
        "nextPage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL for the next page of results"
        },
        "prevPage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL for the previous page of results"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "description": "Unique document ID"
              },
              "uid": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "User-friendly unique identifier"
              },
              "type": {
                "type": "string",
                "description": "Document type (custom type)"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Tags applied to the document"
              },
              "lang": {
                "type": "string",
                "description": "Language code of the document"
              },
              "firstPublicationDate": {
                "type": "string",
                "description": "ISO date of first publication"
              },
              "lastPublicationDate": {
                "type": "string",
                "description": "ISO date of last publication"
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Resolved URL of the document"
              },
              "href": {
                "type": "string",
                "description": "API URL of the document"
              },
              "slugs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "URL slugs for the document"
              },
              "alternateLanguages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string"
                    },
                    "uid": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string"
                    }
                  },
                  "required": ["documentId", "uid", "type", "lang"],
                  "additionalProperties": false
                },
                "description": "Alternate language versions"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "Document field data"
              }
            },
            "required": [
              "documentId",
              "uid",
              "type",
              "tags",
              "lang",
              "firstPublicationDate",
              "lastPublicationDate",
              "url",
              "href",
              "slugs",
              "alternateLanguages",
              "data"
            ],
            "additionalProperties": false
          },
          "description": "Array of matching documents"
        }
      },
      "required": [
        "page",
        "resultsPerPage",
        "totalResults",
        "totalPages",
        "nextPage",
        "prevPage",
        "documents"
      ],
      "additionalProperties": false
    }
  },
