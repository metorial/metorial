          "description": "Markdown content to render as PDF",
          "type": "string"
        },
        "pdfPrintBackground": {
          "description": "Include background colors and graphics. Default: false",
          "type": "boolean"
        },
        "pdfFitOnePage": {
          "description": "Fit all content onto a single page. Default: false",
          "type": "boolean"
        },
        "pdfLandscape": {
          "description": "Use landscape orientation. Default: false (portrait)",
          "type": "boolean"
        },
        "pdfPaperFormat": {
          "description": "Paper size. Default: letter",
          "type": "string",
          "enum": ["a0", "a1", "a2", "a3", "a4", "a5", "a6", "legal", "letter", "tabloid"]
        },
        "pdfMargin": {
          "description": "Uniform margin for all sides (e.g., \"20px\")",
          "type": "string"
        },
        "pdfMarginTop": {
          "description": "Top margin",
          "type": "string"
        },
        "pdfMarginRight": {
          "description": "Right margin",
          "type": "string"
        },
        "pdfMarginBottom": {
          "description": "Bottom margin",
          "type": "string"
        },
        "pdfMarginLeft": {
          "description": "Left margin",
          "type": "string"
        },
        "viewportWidth": {
          "description": "Browser viewport width in pixels",
          "type": "number"
        },
        "viewportHeight": {
          "description": "Browser viewport height in pixels",
          "type": "number"
        },
        "viewportDevice": {
          "description": "Device preset for emulation",
          "type": "string"
        },
        "deviceScaleFactor": {
          "description": "Device pixel ratio (1-5)",
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "blockAds": {
          "description": "Block advertisements",
          "type": "boolean"
        },
        "blockCookieBanners": {
          "description": "Block cookie/GDPR consent banners",
          "type": "boolean"
        },
        "blockChats": {
          "description": "Block chat widgets",
          "type": "boolean"
        },
        "blockTrackers": {
          "description": "Disable analytics trackers",
          "type": "boolean"
        },
        "hideSelectors": {
          "description": "CSS selectors of elements to hide",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scripts": {
          "description": "JavaScript to inject and execute on the page",
          "type": "string"
        },
        "styles": {
          "description": "CSS to inject on the page",
          "type": "string"
        },
        "click": {
          "description": "CSS selector of element to click before capture",
          "type": "string"
        },
        "darkMode": {
          "description": "Render in dark mode",
          "type": "boolean"
        },
        "mediaType": {
          "description": "Media type for rendering",
          "type": "string",
          "enum": ["print", "screen"]
        },
        "ipCountryCode": {
          "description": "Route through proxy in specified country",
          "type": "string",
          "enum": [
            "us",
            "gb",
            "de",
            "it",
            "fr",
            "cn",
            "ca",
            "es",
            "jp",
            "kr",
            "in",
            "au",
            "br",
            "mx",
            "nz",
            "pe",
            "is",
            "ie"
          ]
        },
        "userAgent": {
          "description": "Custom user agent string",
          "type": "string"
        },
        "authorization": {
          "description": "HTTP Authorization header for authenticated pages",
          "type": "string"
        },
        "cookies": {
          "description": "Cookies to set",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headers": {
          "description": "Custom HTTP headers",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeZone": {
          "description": "Timezone for rendering",
          "type": "string"
        },
        "waitUntil": {
          "description": "Page load event to wait for",
          "type": "string",
          "enum": ["load", "domcontentloaded", "networkidle0", "networkidle2"]
        },
        "delay": {
          "description": "Additional wait time in seconds before capture",
          "type": "number"
        },
        "timeout": {
          "description": "Max request duration in seconds",
          "type": "number"
        },
        "waitForSelector": {
          "description": "CSS selector to wait for before capture",
          "type": "string"
        },
        "cache": {
          "description": "Enable CDN caching for this PDF",
          "type": "boolean"
        },
        "cacheTtl": {
          "description": "Cache TTL in seconds",
          "type": "number"
        },
        "store": {
          "description": "Upload PDF to S3 storage",
          "type": "boolean"
        },
        "storagePath": {
          "description": "S3 object key/path",
          "type": "string"
        },
        "storageBucket": {
          "description": "Override default S3 bucket name",
