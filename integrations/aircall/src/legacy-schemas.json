  "manage_user": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"],
          "description": "The operation to perform"
        },
        "userId": {
          "description": "User ID (required for update and delete)",
          "type": "number"
        },
        "email": {
          "description": "Email address (required for create)",
          "type": "string"
        },
        "firstName": {
          "description": "First name (required for create)",
          "type": "string"
        },
        "lastName": {
          "description": "Last name (required for create)",
          "type": "string"
        },
        "availabilityStatus": {
          "description": "Availability status",
          "type": "string",
          "enum": ["available", "custom", "unavailable"]
        },
        "substatus": {
          "description": "Substatus when availabilityStatus is custom",
          "type": "string",
          "enum": ["out_for_lunch", "on_a_break", "in_training", "doing_back_office", "other"]
        },
        "roleIds": {
          "description": "Role IDs: owner, supervisor, admin, agent",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wrapUpTime": {
          "description": "Wrap-up time in seconds after each call",
          "type": "number"
        }
      },
      "required": ["action"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "userId": {
          "description": "User ID",
          "type": "number"
        },
        "name": {
          "description": "Full name of the user",
          "type": "string"
        },
        "email": {
          "description": "Email address",
          "type": "string"
        },
        "deleted": {
          "description": "Whether the user was deleted",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "start_call": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "userId": {
          "type": "number",
          "description": "ID of the user to initiate the call for"
        },
        "numberId": {
          "type": "number",
          "description": "ID of the Aircall number to call from"
        },
        "to": {
          "type": "string",
          "description": "Phone number to call in E.164 format (e.g., +18001234567)"
        }
      },
      "required": ["userId", "numberId", "to"]
