  "create_insight_card": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "callId": {
          "type": "number",
          "description": "ID of the ongoing call to display the insight card on"
        },
        "contents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["title", "shortText"],
                "description": "Card line type: title for headings, shortText for label-value pairs"
              },
              "text": {
                "type": "string",
                "description": "The text content to display"
              },
              "label": {
                "description": "Label shown before the text (only for shortText type)",
                "type": "string"
              },
              "link": {
                "description": "URL to open when the line is clicked",
                "type": "string"
              }
            },
            "required": ["type", "text"]
          },
          "description": "Lines of content to display in the insight card"
        }
      },
      "required": ["callId", "contents"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether the insight card was created successfully"
        },
        "callId": {
          "type": "number",
          "description": "The call ID the insight card was pushed to"
        }
      },
      "required": ["success", "callId"],
      "additionalProperties": false
    }
  }
