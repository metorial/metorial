  "manage_call": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "callId": {
          "type": "number",
          "description": "The ID of the call to manage"
        },
        "action": {
          "type": "string",
          "enum": [
            "transfer",
            "comment",
            "tag",
            "archive",
            "unarchive",
            "pause_recording",
            "resume_recording",
            "delete_recording",
            "delete_voicemail"
          ],
          "description": "The action to perform on the call"
        },
        "transferToUserId": {
          "description": "User ID to transfer the call to (for transfer action)",
          "type": "number"
        },
        "transferToTeamId": {
          "description": "Team ID to transfer the call to (for transfer action)",
          "type": "number"
        },
        "transferToNumber": {
          "description": "External phone number to transfer the call to in E.164 format (for transfer action)",
          "type": "string"
        },
        "dispatchingStrategy": {
          "description": "Strategy for team transfers (default: simultaneous)",
          "type": "string",
          "enum": ["simultaneous", "random", "longest_idle"]
        },
        "commentContent": {
          "description": "Comment text to add to the call (for comment action)",
          "type": "string"
        },
        "tagId": {
          "description": "Tag ID to apply to the call (for tag action)",
          "type": "number"
        }
      },
      "required": ["callId", "action"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether the action was successful"
        },
        "callId": {
          "type": "number",
          "description": "The call ID that was managed"
        },
        "action": {
          "type": "string",
          "description": "The action that was performed"
        }
      },
      "required": ["success", "callId", "action"],
      "additionalProperties": false
    }
  },
  "list_users": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "from": {
          "description": "Start of time range as UNIX timestamp",
