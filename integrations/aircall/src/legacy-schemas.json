                    "type": "null"
                  }
                ],
                "description": "Wrap-up time in seconds"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation date as ISO string"
              }
            },
            "required": [
              "userId",
              "name",
              "email",
              "available",
              "availabilityStatus",
              "timeZone",
              "language",
              "wrapUpTime",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "totalCount": {
          "type": "number",
          "description": "Total number of users"
        },
        "currentPage": {
          "type": "number",
          "description": "Current page number"
        }
      },
      "required": ["users", "totalCount", "currentPage"],
      "additionalProperties": false
    }
  },
