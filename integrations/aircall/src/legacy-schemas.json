  "manage_contact": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "add_phone",
            "update_phone",
            "delete_phone",
            "add_email",
            "update_email",
            "delete_email"
          ],
          "description": "The operation to perform"
        },
        "contactId": {
          "description": "Contact ID (required for update, delete, and phone/email operations)",
          "type": "number"
        },
        "firstName": {
          "description": "First name (required for create)",
          "type": "string"
        },
        "lastName": {
          "description": "Last name (required for create)",
          "type": "string"
        },
        "companyName": {
          "description": "Company name",
          "type": "string"
        },
        "information": {
          "description": "Additional information or notes",
          "type": "string"
        },
        "phoneNumbers": {
          "description": "Phone numbers (required for create, at least one)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Label (e.g., Work, Mobile, Home)"
              },
              "value": {
                "type": "string",
                "description": "Phone number in E.164 format"
              }
            },
            "required": ["label", "value"]
          }
        },
        "emails": {
          "description": "Email addresses",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Label (e.g., Work, Personal)"
              },
              "value": {
                "type": "string",
                "description": "Email address"
              }
            },
            "required": ["label", "value"]
          }
        },
        "phoneNumberId": {
          "description": "Phone number ID (for update_phone/delete_phone)",
          "type": "number"
        },
        "emailId": {
          "description": "Email ID (for update_email/delete_email)",
          "type": "number"
        },
        "label": {
          "description": "Label for phone/email (for add/update phone/email)",
          "type": "string"
        },
        "value": {
          "description": "Value for phone/email (for add/update phone/email)",
          "type": "string"
        }
      },
      "required": ["action"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "contactId": {
          "description": "Contact ID",
          "type": "number"
        },
        "fullName": {
          "description": "Full name of the contact",
          "type": "string"
        },
        "deleted": {
          "description": "Whether the contact was deleted",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
