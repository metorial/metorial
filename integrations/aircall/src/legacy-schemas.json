{
  "list_calls": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "userId": {
          "description": "Filter calls by user ID",
          "type": "number"
        },
        "phoneNumber": {
          "description": "Filter calls by phone number (E.164 format)",
          "type": "string"
        },
        "contactId": {
          "description": "Filter calls by contact ID",
          "type": "number"
        },
        "direction": {
          "description": "Filter by call direction",
          "type": "string",
          "enum": ["inbound", "outbound"]
        },
        "tags": {
          "description": "Filter by tag names (AND condition)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "description": "Start of time range as UNIX timestamp",
          "type": "number"
        },
        "to": {
          "description": "End of time range as UNIX timestamp",
          "type": "number"
        },
        "order": {
          "description": "Sort order by start time",
          "type": "string",
          "enum": ["asc", "desc"]
        },
        "includeContacts": {
          "description": "Include contact data in results",
          "type": "boolean"
        },
        "page": {
          "description": "Page number (default: 1)",
          "type": "number"
        },
        "perPage": {
          "description": "Results per page (max: 50, default: 20)",
          "type": "number"
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "callId": {
                "type": "number",
                "description": "Unique call identifier"
              },
              "direction": {
                "type": "string",
                "description": "Call direction (inbound or outbound)"
              },
              "status": {
                "type": "string",
                "description": "Call status"
              },
              "rawDigits": {
                "type": "string",
                "description": "Phone number in E.164 format or \"anonymous\""
              },
              "startedAt": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Call start time as UNIX timestamp"
              },
              "answeredAt": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Call answer time as UNIX timestamp"
              },
              "endedAt": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Call end time as UNIX timestamp"
              },
              "duration": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Call duration in seconds"
              },
              "recording": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Recording URL (valid for 10 minutes)"
              },
              "voicemail": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Voicemail URL (valid for 10 minutes)"
              },
              "archived": {
                "type": "boolean",
                "description": "Whether the call is archived"
              },
              "missedCallReason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Reason the call was missed"
              },
              "userName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Name of the user who handled the call"
              },
              "numberDigits": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Aircall number used"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tagId": {
                      "type": "number"
                    },
                    "tagName": {
                      "type": "string"
                    }
                  },
                  "required": ["tagId", "tagName"],
                  "additionalProperties": false
                },
                "description": "Tags applied to the call"
              },
              "commentsCount": {
                "type": "number",
                "description": "Number of comments on the call"
              }
            },
            "required": [
              "callId",
              "direction",
              "status",
              "rawDigits",
              "startedAt",
              "answeredAt",
              "endedAt",
              "duration",
              "recording",
              "voicemail",
              "archived",
              "missedCallReason",
              "userName",
              "numberDigits",
              "tags",
              "commentsCount"
            ],
            "additionalProperties": false
          }
        },
        "totalCount": {
          "type": "number",
          "description": "Total number of matching calls"
        },
        "currentPage": {
          "type": "number",
          "description": "Current page number"
        },
        "perPage": {
          "type": "number",
          "description": "Results per page"
        }
      },
      "required": ["calls", "totalCount", "currentPage", "perPage"],
      "additionalProperties": false
    }
  },
