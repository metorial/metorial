{
  "create_candidate": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "First name of the candidate"
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the candidate"
        },
        "email": {
          "description": "Email address of the candidate",
          "type": "string"
        },
        "emailType": {
          "default": "Personal",
          "description": "Type of the email address",
          "type": "string",
          "enum": ["Personal", "Work", "Other"]
        },
        "phone": {
          "description": "Phone number of the candidate",
          "type": "string"
        },
        "phoneType": {
          "default": "Personal",
          "description": "Type of the phone number",
          "type": "string",
          "enum": ["Personal", "Work", "Other", "Mobile"]
        },
        "socialLinks": {
          "description": "Array of social profile links for the candidate",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of social link (e.g. LinkedIn, GitHub, Twitter)"
              },
              "url": {
                "type": "string",
                "description": "URL of the social profile"
              }
            },
            "required": ["type", "url"],
            "additionalProperties": false
          }
        }
      },
      "required": ["firstName", "lastName", "emailType", "phoneType"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "description": "Unique ID of the created candidate"
        },
        "name": {
          "type": "string",
          "description": "Full name of the candidate"
        },
        "primaryEmail": {
          "description": "Primary email address of the candidate",
          "type": "string"
        },
        "primaryPhone": {
          "description": "Primary phone number of the candidate",
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["candidateId", "name", "createdAt"],
      "additionalProperties": false
    }
  },
  "get_candidate": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidateId": {
          "description": "Unique ID of the candidate to retrieve",
          "type": "string"
        },
        "email": {
          "description": "Email address to search for",
          "type": "string"
        },
        "name": {
          "description": "Name to search for",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "description": "Unique ID of the candidate"
        },
        "name": {
          "type": "string",
          "description": "Full name of the candidate"
        },
        "primaryEmail": {
          "description": "Primary email address",
          "type": "string"
        },
        "primaryPhone": {
          "description": "Primary phone number",
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tagId": {
                "type": "string",
                "description": "Unique ID of the tag"
              },
              "title": {
                "type": "string",
                "description": "Title of the tag"
              }
            },
            "required": ["tagId", "title"],
            "additionalProperties": false
          },
          "description": "Tags associated with the candidate"
        },
        "emails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All email addresses for the candidate"
        },
        "phoneNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All phone numbers for the candidate"
        },
        "socialProfiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Social profile URLs for the candidate"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Location names for the candidate"
        },
        "customFields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldId": {
                "type": "string",
                "description": "Unique ID of the custom field"
              },
              "title": {
                "type": "string",
                "description": "Display name of the custom field"
              },
              "value": {
                "description": "Value of the custom field"
              }
            },
            "required": ["fieldId", "title", "value"],
            "additionalProperties": false
          },
          "description": "Custom field values set on the candidate"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "candidateId",
        "name",
        "tags",
        "emails",
        "phoneNumbers",
        "socialProfiles",
        "locations",
        "customFields",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "update_candidate": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "description": "Candidate ID to update"
        },
        "name": {
          "description": "New full name for the candidate",
          "type": "string"
        },
        "email": {
          "description": "Email address to set as primary",
          "type": "string"
        },
        "emailType": {
          "description": "Type of email address",
          "type": "string",
          "enum": ["Personal", "Work", "Other"]
        },
        "phone": {
          "description": "Phone number to set as primary",
          "type": "string"
        },
        "phoneType": {
          "description": "Type of phone number",
          "type": "string",
          "enum": ["Personal", "Work", "Other", "Mobile"]
        },
        "socialLinks": {
          "description": "Social links to set on the candidate profile",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Social link type (e.g., LinkedIn, GitHub, Twitter)"
              },
              "url": {
                "type": "string",
                "description": "Social link URL"
              }
            },
            "required": ["type", "url"],
            "additionalProperties": false
          }
        },
        "tagId": {
          "description": "Tag ID to add to the candidate",
          "type": "string"
        },
        "note": {
          "description": "Note text to add to the candidate",
          "type": "string"
        },
        "projectId": {
          "description": "Project ID to add the candidate to",
          "type": "string"
        }
      },
      "required": ["candidateId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "description": "Candidate ID"
        },
        "name": {
          "type": "string",
          "description": "Candidate full name"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["candidateId", "name", "updatedAt"],
      "additionalProperties": false
    }
  },
  "create_application": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "description": "ID of the candidate to create the application for"
        },
        "jobId": {
          "type": "string",
          "description": "ID of the job to apply the candidate to"
        },
        "interviewPlanId": {
          "description": "ID of the interview plan to use",
          "type": "string"
        },
        "interviewStageId": {
          "description": "ID of the interview stage to start the application at",
          "type": "string"
        },
        "sourceId": {
          "description": "ID of the source to attribute the application to",
          "type": "string"
        },
        "creditedToUserId": {
          "description": "ID of the user to credit for this application",
          "type": "string"
        }
      },
      "required": ["candidateId", "jobId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "description": "Unique ID of the application"
        },
        "status": {
          "type": "string",
          "description": "Current status of the application"
        },
        "candidateName": {
          "type": "string",
          "description": "Name of the candidate"
        },
        "jobTitle": {
          "type": "string",
          "description": "Title of the job"
        },
        "currentStage": {
          "description": "Current interview stage, if any",
          "type": "object",
          "properties": {
            "stageId": {
              "type": "string",
              "description": "ID of the current interview stage"
            },
            "title": {
              "type": "string",
              "description": "Title of the current interview stage"
            }
          },
          "required": ["stageId", "title"],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["applicationId", "status", "candidateName", "jobTitle", "createdAt"],
      "additionalProperties": false
    }
  },
  "update_application": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "description": "ID of the application to update"
        },
        "interviewStageId": {
          "description": "ID of the interview stage to move the application to",
          "type": "string"
        },
        "archiveReasonId": {
          "description": "ID of the archive reason (required when moving to an archived stage)",
          "type": "string"
        },
        "sourceId": {
          "description": "ID of the new source to set on the application",
          "type": "string"
        },
        "transferToJobId": {
          "description": "ID of the job to transfer the application to",
          "type": "string"
        },
        "transferToInterviewPlanId": {
          "description": "ID of the interview plan to use when transferring to a new job",
          "type": "string"
        },
        "addHiringTeamMember": {
          "description": "Add a user to the hiring team for this application",
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "description": "ID of the user to add to the hiring team"
            },
            "role": {
              "type": "string",
              "description": "Role of the hiring team member (e.g., \"Hiring Manager\", \"Recruiter\", \"Sourcer\")"
            }
          },
          "required": ["userId", "role"],
          "additionalProperties": false
        },
        "removeHiringTeamMember": {
          "description": "Remove a user from the hiring team for this application",
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "description": "ID of the user to remove from the hiring team"
            },
            "role": {
              "type": "string",
              "description": "Role of the hiring team member to remove"
            }
          },
          "required": ["userId", "role"],
          "additionalProperties": false
        }
      },
      "required": ["applicationId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "description": "Unique ID of the application"
        },
        "status": {
          "type": "string",
          "description": "Current status of the application"
        },
        "candidateName": {
          "type": "string",
          "description": "Name of the candidate"
        },
        "jobTitle": {
          "type": "string",
          "description": "Title of the job"
        },
        "currentStage": {
          "description": "Current interview stage, if any",
          "type": "object",
          "properties": {
            "stageId": {
              "type": "string",
              "description": "ID of the current interview stage"
            },
            "title": {
              "type": "string",
              "description": "Title of the current interview stage"
            }
          },
          "required": ["stageId", "title"],
          "additionalProperties": false
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["applicationId", "status", "candidateName", "jobTitle", "updatedAt"],
      "additionalProperties": false
    }
  },
