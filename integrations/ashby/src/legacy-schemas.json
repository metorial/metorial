  "list_jobs": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "searchTerm": {
          "description": "Search term to filter jobs by title or other fields",
          "type": "string"
        },
        "status": {
          "description": "Filter jobs by status",
          "type": "string",
          "enum": ["Open", "Closed", "Archived", "Draft"]
        },
        "cursor": {
          "description": "Pagination cursor from a previous request",
          "type": "string"
        },
        "perPage": {
          "default": 50,
          "description": "Number of results per page",
          "type": "number"
        }
      },
      "required": ["perPage"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "description": "Unique ID of the job"
              },
              "title": {
                "type": "string",
                "description": "Job title"
              },
              "status": {
                "type": "string",
                "description": "Current status of the job"
              },
              "locationId": {
                "description": "Location ID associated with the job",
                "type": "string"
              },
              "departmentId": {
                "description": "Department ID associated with the job",
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp"
              },
              "updatedAt": {
                "type": "string",
                "description": "Last updated timestamp"
              }
            },
            "required": ["jobId", "title", "status", "createdAt", "updatedAt"],
            "additionalProperties": false
          },
          "description": "List of jobs matching the query"
        },
        "nextCursor": {
          "description": "Pagination cursor for the next page",
          "type": "string"
        }
      },
      "required": ["jobs"],
      "additionalProperties": false
    }
  },
