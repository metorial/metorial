  "manage_offer": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "get", "list", "update", "approve", "start"],
          "description": "The offer action to perform"
        },
        "offerId": {
          "description": "Offer ID (required for get, update, approve, and start)",
          "type": "string"
        },
        "applicationId": {
          "description": "Application ID (for create)",
          "type": "string"
        },
        "offerFields": {
          "description": "Offer form field values (for create and update)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "cursor": {
          "description": "Pagination cursor (for list action)",
          "type": "string"
        },
        "perPage": {
          "description": "Number of results per page (for list action)",
          "type": "number"
        }
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "offer": {
