  "send_conversion_events": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "conversionUrn": {
                "type": "string",
                "description": "URN of the conversion rule"
              },
              "conversionHappenedAt": {
                "type": "number",
                "description": "Timestamp of conversion in epoch milliseconds"
              },
              "conversionValue": {
                "description": "Monetary value of the conversion",
                "type": "object",
                "properties": {
                  "currencyCode": {
                    "type": "string",
                    "description": "ISO currency code"
                  },
                  "amount": {
                    "type": "string",
                    "description": "Conversion value amount"
                  }
                },
                "required": ["currencyCode", "amount"],
                "additionalProperties": false
              },
              "eventId": {
                "description": "Unique event ID for deduplication",
                "type": "string"
              },
              "userIds": {
                "description": "User identifiers for matching",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "idType": {
                      "type": "string",
                      "description": "ID type (e.g., SHA256_EMAIL, LINKEDIN_FIRST_PARTY_ADS_TRACKING_UUID)"
                    },
                    "idValue": {
                      "type": "string",
                      "description": "The ID value"
                    }
                  },
                  "required": ["idType", "idValue"],
                  "additionalProperties": false
                }
              },
              "userInfo": {
                "description": "Additional user information for matching",
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "companyName": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "countryCode": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["conversionUrn", "conversionHappenedAt"],
            "additionalProperties": false
          },
          "description": "Array of conversion events to send"
        }
      },
      "required": ["events"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "eventCount": {
          "type": "number",
          "description": "Number of events sent"
        }
      },
      "required": ["success", "eventCount"],
      "additionalProperties": false
    }
  },
