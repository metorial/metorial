{
  "list_ad_accounts": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "search": {
          "description": "Filter accounts by name",
          "type": "string"
        },
        "pageSize": {
          "description": "Number of results per page (max 100)",
          "type": "number"
        },
        "pageToken": {
          "description": "Page token for pagination",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "number",
                "description": "Numeric ID of the ad account"
              },
              "name": {
                "type": "string",
                "description": "Name of the ad account"
              },
              "status": {
                "type": "string",
                "description": "Account status (ACTIVE, CANCELED, DRAFT, etc.)"
              },
              "type": {
                "type": "string",
                "description": "Account type (BUSINESS, ENTERPRISE)"
              },
              "currency": {
                "type": "string",
                "description": "Currency code for the account"
              },
              "reference": {
                "type": "string",
                "description": "URN of the associated organization"
              },
              "servingStatuses": {
                "description": "Current serving statuses",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["accountId", "name", "status", "type", "currency", "reference"],
            "additionalProperties": false
          }
        },
        "totalCount": {
          "description": "Total number of accounts",
          "type": "number"
        }
      },
      "required": ["accounts"],
      "additionalProperties": false
    }
  },
  "get_ad_account": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
