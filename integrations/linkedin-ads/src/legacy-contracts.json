  "get_ad_analytics": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pivot": {
          "type": "string",
          "enum": [
            "ACCOUNT",
            "CAMPAIGN",
            "CAMPAIGN_GROUP",
            "CREATIVE",
            "MEMBER_COMPANY",
            "MEMBER_COMPANY_SIZE",
            "MEMBER_JOB_FUNCTION",
            "MEMBER_JOB_TITLE",
            "MEMBER_INDUSTRY",
            "MEMBER_SENIORITY",
            "MEMBER_COUNTRY",
            "MEMBER_REGION"
          ],
          "description": "Dimension to group results by"
        },
        "startDate": {
          "type": "object",
          "properties": {
            "year": {
              "type": "number",
              "description": "Year (e.g., 2025)"
            },
            "month": {
              "type": "number",
              "description": "Month (1-12)"
            },
            "day": {
              "type": "number",
              "description": "Day of month (1-31)"
            }
          },
          "required": ["year", "month", "day"],
          "additionalProperties": false,
          "description": "Start date for the analytics period"
        },
        "endDate": {
          "type": "object",
          "properties": {
            "year": {
              "type": "number",
              "description": "Year (e.g., 2025)"
            },
            "month": {
              "type": "number",
              "description": "Month (1-12)"
            },
            "day": {
              "type": "number",
              "description": "Day of month (1-31)"
            }
          },
          "required": ["year", "month", "day"],
          "additionalProperties": false,
          "description": "End date for the analytics period (exclusive)"
        },
        "timeGranularity": {
          "default": "ALL",
          "description": "Time granularity for breakdown",
          "type": "string",
          "enum": ["DAILY", "MONTHLY", "ALL"]
        },
        "accountIds": {
          "description": "Ad account IDs to query",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "campaignIds": {
          "description": "Campaign IDs to query",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "creativeIds": {
          "description": "Creative IDs (URN format) to query",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "campaignGroupIds": {
          "description": "Campaign group IDs to query",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "description": "Specific metric fields to return (e.g., [\"impressions\", \"clicks\", \"costInLocalCurrency\"])",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["pivot", "startDate", "endDate", "timeGranularity"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "analytics": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "Array of analytics data rows with requested metrics"
        },
        "totalCount": {
          "description": "Total number of rows",
          "type": "number"
        }
      },
      "required": ["analytics"],
      "additionalProperties": false
    }
  },
