      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accountId": {
          "type": "number",
          "description": "Numeric ID of the ad account"
        },
        "name": {
          "type": "string",
          "description": "Name of the ad account"
        },
        "status": {
          "type": "string",
          "description": "Account status"
        },
        "type": {
          "type": "string",
          "description": "Account type"
        },
        "currency": {
          "type": "string",
          "description": "Currency code"
        },
        "reference": {
          "type": "string",
          "description": "URN of the associated organization"
        },
        "servingStatuses": {
          "description": "Current serving statuses",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalBudget": {
          "description": "Total budget for the account",
          "type": "object",
          "properties": {
            "amount": {
              "type": "string"
            },
            "currencyCode": {
              "type": "string"
            }
          },
          "required": ["amount", "currencyCode"],
          "additionalProperties": false
        },
        "notifiedOnCreativeApproval": {
          "type": "boolean"
        },
        "notifiedOnCreativeRejection": {
          "type": "boolean"
        },
        "notifiedOnEndOfCampaign": {
          "type": "boolean"
        }
      },
      "required": ["accountId", "name", "status", "type", "currency", "reference"],
      "additionalProperties": false
    }
  },
