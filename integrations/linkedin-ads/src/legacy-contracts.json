  "create_campaign_group": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "description": "Numeric ID of the ad account"
        },
        "name": {
          "type": "string",
          "description": "Name for the campaign group"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "PAUSED", "ARCHIVED", "DRAFT"],
          "description": "Initial status of the campaign group"
        },
        "totalBudget": {
          "description": "Total budget for the campaign group",
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Budget amount as string (e.g., \"1000.00\")"
            },
            "currencyCode": {
              "type": "string",
              "description": "ISO currency code (e.g., \"USD\")"
            }
          },
          "required": ["amount", "currencyCode"],
          "additionalProperties": false
        },
        "runScheduleStart": {
          "description": "Start date as epoch milliseconds",
          "type": "number"
        },
        "runScheduleEnd": {
          "description": "End date as epoch milliseconds",
          "type": "number"
        }
      },
      "required": ["accountId", "name", "status"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignGroupId": {
          "type": "string",
          "description": "ID of the created campaign group"
        }
      },
      "required": ["campaignGroupId"],
      "additionalProperties": false
    }
  },
