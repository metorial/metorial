  "create_campaign": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "description": "Numeric ID of the ad account"
        },
        "campaignGroupId": {
          "type": "string",
          "description": "Numeric ID of the campaign group"
        },
        "name": {
          "type": "string",
          "description": "Campaign name"
        },
        "objectiveType": {
          "type": "string",
          "description": "Campaign objective (e.g., BRAND_AWARENESS, WEBSITE_VISITS, LEAD_GENERATION)"
        },
        "type": {
          "type": "string",
          "description": "Campaign type (e.g., SPONSORED_UPDATES, TEXT_AD, SPONSORED_INMAILS)"
        },
        "costType": {
          "type": "string",
          "description": "Cost type (e.g., CPM, CPC, CPV)"
        },
        "status": {
          "default": "DRAFT",
          "description": "Initial campaign status",
          "type": "string",
          "enum": ["ACTIVE", "PAUSED", "ARCHIVED", "DRAFT"]
        },
        "dailyBudget": {
          "description": "Daily budget",
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Budget amount as string (e.g., \"50.00\")"
            },
            "currencyCode": {
              "type": "string",
              "description": "ISO currency code (e.g., \"USD\")"
            }
          },
          "required": ["amount", "currencyCode"],
          "additionalProperties": false
        },
        "totalBudget": {
          "description": "Total campaign budget",
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Budget amount as string (e.g., \"50.00\")"
            },
            "currencyCode": {
              "type": "string",
              "description": "ISO currency code (e.g., \"USD\")"
            }
          },
          "required": ["amount", "currencyCode"],
          "additionalProperties": false
        },
        "unitCost": {
          "description": "Bid amount per unit",
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Budget amount as string (e.g., \"50.00\")"
            },
            "currencyCode": {
              "type": "string",
              "description": "ISO currency code (e.g., \"USD\")"
            }
          },
          "required": ["amount", "currencyCode"],
          "additionalProperties": false
        },
        "runScheduleStart": {
          "description": "Start date as epoch milliseconds",
          "type": "number"
        },
        "runScheduleEnd": {
          "description": "End date as epoch milliseconds",
          "type": "number"
        },
        "locale": {
          "description": "Locale for the campaign",
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "description": "ISO country code (e.g., \"US\")"
            },
            "language": {
              "type": "string",
              "description": "ISO language code (e.g., \"en\")"
            }
          },
          "required": ["country", "language"],
          "additionalProperties": false
        },
        "audienceExpansionEnabled": {
          "description": "Enable audience expansion",
          "type": "boolean"
        },
        "offsiteDeliveryEnabled": {
          "description": "Enable offsite delivery",
          "type": "boolean"
        },
        "optimizationTargetType": {
          "description": "Optimization target (e.g., MAX_CLICK, MAX_IMPRESSION, MAX_CONVERSION)",
          "type": "string"
        },
        "targetingCriteria": {
          "description": "Targeting criteria JSON object"
        }
      },
      "required": [
        "accountId",
        "campaignGroupId",
        "name",
        "objectiveType",
        "type",
        "costType",
        "status"
      ],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "description": "ID of the created campaign"
        }
      },
      "required": ["campaignId"],
      "additionalProperties": false
    }
  },
