      "type": "object",
      "properties": {
        "fileUrl": {
          "type": "string",
          "description": "Publicly accessible URL of the file to upload"
        },
        "fileName": {
          "type": "string",
          "description": "File name including extension (e.g., \"photo.jpg\")"
        },
        "name": {
          "description": "Display name for the file in the media library",
          "type": "string"
        },
        "alternativeText": {
          "description": "Alternative text for accessibility",
          "type": "string"
        },
        "caption": {
          "description": "Caption for the file",
          "type": "string"
        }
      },
      "required": ["fileUrl", "fileName"],
