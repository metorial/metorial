{
  "list_entries": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "description": "Plural API ID of the content type (e.g., \"articles\", \"products\")"
        },
        "fields": {
          "description": "Specific fields to return (e.g., [\"title\", \"description\"])",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "populate": {
          "description": "Relations to populate. Use \"*\" for all, or an object for granular control",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          ]
        },
        "filters": {
          "description": "Filter criteria using Strapi operators (e.g., {\"title\": {\"$contains\": \"hello\"}})",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sort": {
          "description": "Sort order (e.g., \"createdAt:desc\" or [\"title:asc\", \"createdAt:desc\"])",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "page": {
          "description": "Page number for pagination (default: 1)",
          "type": "number"
        },
        "pageSize": {
          "description": "Number of entries per page (default: 25)",
          "type": "number"
        },
        "status": {
          "description": "Filter by publication status (requires Draft & Publish enabled)",
          "type": "string",
          "enum": ["draft", "published"]
        },
        "locale": {
          "description": "Locale code for i18n content (e.g., \"en\", \"fr\")",
          "type": "string"
        }
      },
      "required": ["contentType"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "description": "List of content entries"
        },
        "pagination": {
          "description": "Pagination metadata",
          "type": "object",
          "properties": {
            "page": {
              "type": "number"
            },
            "pageSize": {
              "type": "number"
            },
            "pageCount": {
              "type": "number"
            },
            "total": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    }
  },
  "get_entry": {
