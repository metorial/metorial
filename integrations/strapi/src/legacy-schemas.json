            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          ]
        },
        "status": {
          "description": "Retrieve draft or published version",
          "type": "string",
          "enum": ["draft", "published"]
        },
        "locale": {
          "description": "Locale code for i18n content",
          "type": "string"
        }
