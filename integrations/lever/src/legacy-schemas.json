  "manage_requisition": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"],
          "description": "Action to perform"
        },
        "requisitionId": {
          "description": "Requisition ID (required for update/delete)",
          "type": "string"
        },
        "name": {
          "description": "Requisition name",
          "type": "string"
        },
        "headcountTotal": {
          "description": "Total headcount for this requisition",
          "type": "number"
        },
        "compensationBand": {
          "description": "Compensation band",
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            },
            "interval": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "ownerId": {
          "description": "User ID of the requisition owner",
          "type": "string"
        },
        "hiringManagerId": {
          "description": "User ID of the hiring manager",
          "type": "string"
        },
        "status": {
          "description": "Requisition status",
          "type": "string",
          "enum": ["open", "onHold", "closed", "draft"]
        },
        "customFields": {
          "description": "Custom fields as key-value pairs",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "postingIds": {
          "description": "Posting IDs to associate",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requisitionId": {
          "description": "ID of the requisition",
          "type": "string"
