              },
              "status": {
                "type": "string",
                "description": "Webset status: idle, pending, running, or paused"
              },
              "title": {
                "description": "Webset title",
                "type": "string"
              },
              "externalId": {
                "description": "External reference identifier",
                "type": "string"
              },
              "metadata": {
                "description": "Custom key-value metadata",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp"
              },
              "updatedAt": {
                "type": "string",
                "description": "Last update timestamp"
              }
            },
            "required": ["websetId", "status", "createdAt", "updatedAt"],
            "additionalProperties": false
          },
          "description": "List of Websets"
        },
        "hasMore": {
          "type": "boolean",
          "description": "Whether more results are available"
        },
        "nextCursor": {
          "description": "Cursor for the next page",
          "type": "string"
        }
      },
      "required": ["websets", "hasMore"],
      "additionalProperties": false
    }
  },
  "update_webset": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "websetId": {
          "type": "string",
          "description": "The Webset ID to update"
        },
