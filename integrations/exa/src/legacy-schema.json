{
  "web_search": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The search query"
        },
        "searchType": {
          "description": "Search method to use. Default: auto",
          "type": "string",
          "enum": ["neural", "auto", "fast", "deep"]
        },
        "category": {
          "description": "Focus on a specific content category",
          "type": "string",
          "enum": [
            "company",
            "research paper",
            "news",
            "tweet",
            "personal site",
            "financial report",
            "people"
          ]
        },
        "numResults": {
          "description": "Number of results to return (1-100, default: 10)",
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "includeDomains": {
          "description": "Only include results from these domains",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeDomains": {
          "description": "Exclude results from these domains",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startPublishedDate": {
          "description": "Filter results published after this ISO 8601 date",
          "type": "string"
        },
        "endPublishedDate": {
          "description": "Filter results published before this ISO 8601 date",
          "type": "string"
        },
        "startCrawlDate": {
          "description": "Filter results crawled after this ISO 8601 date",
          "type": "string"
        },
        "endCrawlDate": {
          "description": "Filter results crawled before this ISO 8601 date",
          "type": "string"
        },
        "includeText": {
          "description": "Only include results containing these text strings",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeText": {
          "description": "Exclude results containing these text strings",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contents": {
          "description": "Controls what content to retrieve for each result",
          "type": "object",
          "properties": {
            "text": {
              "description": "Return the full text content of results as markdown",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "maxCharacters": {
                      "description": "Maximum number of characters to return",
                      "type": "number"
                    },
                    "includeHtmlTags": {
                      "description": "Whether to include HTML tags in the text",
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "highlights": {
              "description": "Return key excerpts most relevant to the query",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "maxCharacters": {
                      "description": "Maximum number of characters per highlight",
                      "type": "number"
                    },
                    "query": {
                      "description": "Custom query for highlight extraction",
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "summary": {
              "description": "Return a concise AI-generated summary",
              "type": "object",
              "properties": {
                "query": {
                  "description": "Custom query to tailor the summary",
                  "type": "string"
                }
              }
            },
            "livecrawl": {
              "description": "Live crawl mode for fetching fresh content",
              "type": "string",
              "enum": ["always", "preferred", "fallback", "never"]
            },
            "subpages": {
              "description": "Number of subpages to crawl",
              "type": "number"
            },
            "extras": {
              "description": "Additional data to extract",
              "type": "object",
              "properties": {
                "links": {
                  "description": "Number of links to extract",
                  "type": "number"
                },
                "imageLinks": {
                  "description": "Number of image links to extract",
                  "type": "number"
                }
              }
            }
          }
        },
        "moderation": {
          "description": "Filter out unsafe content",
          "type": "boolean"
        },
        "maxAgeHours": {
          "description": "Maximum age of content in hours",
          "type": "number"
        }
      },
      "required": ["query"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Unique request identifier"
        },
        "searchType": {
          "description": "Search method that was used",
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resultId": {
                "type": "string",
                "description": "Unique result identifier"
              },
              "title": {
                "type": "string",
                "description": "Page title"
              },
              "url": {
                "type": "string",
                "description": "Page URL"
              },
              "publishedDate": {
                "description": "Publication date in ISO 8601 format",
                "type": "string"
              },
              "author": {
                "description": "Content author",
                "type": "string"
              },
              "text": {
                "description": "Full text content as markdown",
                "type": "string"
              },
              "highlights": {
                "description": "Key excerpts from the content",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "description": "AI-generated summary",
                "type": "string"
              }
            },
            "required": ["resultId", "title", "url"],
            "additionalProperties": false
          },
          "description": "Search results"
        }
      },
      "required": ["requestId", "results"],
      "additionalProperties": false
    }
  },
  "get_contents": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "urls": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "URLs to extract content from"
        },
        "text": {
          "description": "Return full text content as markdown",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "maxCharacters": {
                  "description": "Maximum characters to return",
                  "type": "number"
                },
                "includeHtmlTags": {
                  "description": "Include HTML tags",
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "highlights": {
          "description": "Return key excerpts",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "maxCharacters": {
                  "description": "Maximum characters per highlight",
                  "type": "number"
                },
                "query": {
                  "description": "Custom query for highlight extraction",
                  "type": "string"
                }
              }
            }
          ]
        },
        "summary": {
          "description": "Return an AI-generated summary",
          "type": "object",
          "properties": {
            "query": {
              "description": "Custom query to tailor the summary",
              "type": "string"
            }
          }
        },
        "subpages": {
          "description": "Number of subpages to crawl per URL",
          "type": "number"
        },
        "livecrawlTimeout": {
          "description": "Timeout for live crawling in milliseconds (default: 10000)",
          "type": "number"
        }
      },
      "required": ["urls"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Unique request identifier"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Page title"
              },
              "url": {
                "type": "string",
                "description": "Page URL"
              },
              "publishedDate": {
                "description": "Publication date",
                "type": "string"
              },
              "author": {
                "description": "Content author",
                "type": "string"
              },
              "text": {
                "description": "Full text content as markdown",
                "type": "string"
              },
              "highlights": {
                "description": "Key excerpts",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "description": "AI-generated summary",
                "type": "string"
              }
            },
            "required": ["title", "url"],
            "additionalProperties": false
          },
          "description": "Extracted content for each URL"
        }
      },
      "required": ["requestId", "results"],
      "additionalProperties": false
    }
  },
