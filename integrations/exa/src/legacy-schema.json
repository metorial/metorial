  "answer_question": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The question to answer"
        },
        "includeSourceText": {
          "description": "Include the full text of cited sources in the response",
          "type": "boolean"
        }
      },
      "required": ["query"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "description": "The AI-generated answer"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "Source URL"
              },
              "title": {
                "description": "Source page title",
                "type": "string"
              },
              "author": {
                "description": "Source author",
                "type": "string"
              },
              "publishedDate": {
                "description": "Publication date",
                "type": "string"
              },
              "text": {
                "description": "Source text content (when includeSourceText is true)",
                "type": "string"
              }
            },
            "required": ["url"],
            "additionalProperties": false
          },
          "description": "Web sources cited in the answer"
        }
      },
      "required": ["answer", "citations"],
      "additionalProperties": false
    }
  },
  "create_research": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "maxLength": 4096,
          "description": "Instructions for what to research"
        },
        "model": {
          "description": "Research model to use (default: exa-research)",
          "type": "string",
          "enum": ["exa-research-fast", "exa-research", "exa-research-pro"]
        },
        "outputSchema": {
          "description": "JSON Schema for structured output format",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["instructions"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "researchId": {
          "type": "string",
          "description": "Unique research task identifier for polling"
        },
        "status": {
          "type": "string",
          "description": "Current status: pending, running, completed, failed, or canceled"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        }
      },
      "required": ["researchId", "status", "createdAt"],
      "additionalProperties": false
    }
  },
  "get_research_status": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "researchId": {
          "type": "string",
          "description": "The research task ID returned by Create Research"
        }
      },
      "required": ["researchId"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "researchId": {
          "type": "string",
          "description": "Research task identifier"
        },
        "status": {
          "type": "string",
          "description": "Current status: pending, running, completed, failed, or canceled"
        },
        "content": {
          "description": "Research output content (available when completed)",
          "type": "string"
        },
        "parsedOutput": {
          "description": "Structured output if an output schema was provided",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "error": {
          "description": "Error message if the task failed",
          "type": "string"
        },
        "costTotal": {
          "description": "Total cost in USD",
          "type": "number"
        },
        "finishedAt": {
          "description": "Completion timestamp in milliseconds",
          "type": "number"
        }
      },
      "required": ["researchId", "status"],
      "additionalProperties": false
    }
  },
  "create_webset": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "description": "Natural language search description (1-5000 chars)",
          "type": "string"
        },
        "count": {
          "description": "Target number of results (default: 10)",
          "type": "number"
        },
        "entity": {
          "description": "Entity type to search for",
          "type": "string",
          "enum": ["company", "person", "article", "research_paper", "custom"]
        },
        "criteria": {
          "description": "Custom evaluation criteria (max 5)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "Criterion description for verifying results"
              }
            },
            "required": ["description"]
          }
        },
        "enrichments": {
          "description": "Data extraction tasks for found items",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "Description of data to extract"
              },
              "format": {
                "description": "Expected format of the enrichment value",
                "type": "string"
              }
            },
            "required": ["description"]
          }
        },
        "title": {
          "description": "Custom name for the Webset",
          "type": "string"
        },
        "externalId": {
          "description": "Your internal identifier (max 300 chars)",
          "type": "string"
        },
        "metadata": {
          "description": "Custom key-value pairs",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "websetId": {
          "type": "string",
          "description": "Webset identifier"
        },
        "status": {
          "type": "string",
          "description": "Webset status: idle, pending, running, or paused"
        },
        "title": {
          "description": "Webset title",
          "type": "string"
        },
        "externalId": {
          "description": "External reference identifier",
          "type": "string"
        },
        "metadata": {
          "description": "Custom key-value metadata",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["websetId", "status", "createdAt", "updatedAt"],
      "additionalProperties": false
    }
  },
