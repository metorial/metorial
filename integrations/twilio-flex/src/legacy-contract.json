{
  "create_interaction": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "channelType": {
          "type": "string",
          "enum": ["sms", "whatsapp", "web", "voice", "email", "custom"],
          "description": "Communication channel type"
        },
        "channelProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Channel-specific properties as a JSON object (e.g., {\"type\": \"sms\", \"to\": \"+1234567890\", \"from\": \"+0987654321\"})"
        },
        "routingWorkflowSid": {
          "type": "string",
          "description": "TaskRouter Workflow SID for routing this interaction"
        },
        "routingWorkspaceSid": {
          "type": "string",
          "description": "TaskRouter Workspace SID"
        },
        "routingAttributes": {
          "description": "Additional routing attributes as key-value pairs",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "interactionContextJson": {
          "description": "JSON string with additional interaction context",
          "type": "string"
        }
      },
      "required": [
        "channelType",
        "channelProperties",
        "routingWorkflowSid",
        "routingWorkspaceSid"
      ],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "interactionSid": {
          "type": "string",
          "description": "SID of the created interaction"
        },
        "channelSid": {
          "description": "SID of the created channel",
          "type": "string"
        },
        "url": {
          "description": "URL of the interaction resource",
          "type": "string"
        }
      },
      "required": ["interactionSid"],
      "additionalProperties": false
    }
  },
  "manage_interaction_channel": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["get", "list", "close"],
          "description": "Action to perform on the channel"
        },
        "interactionSid": {
          "type": "string",
          "description": "Interaction SID"
        },
        "channelSid": {
          "description": "Channel SID (required for get/close)",
          "type": "string"
        }
      },
      "required": ["action", "interactionSid"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channelSid": {
                "type": "string",
                "description": "Channel SID"
              },
              "interactionSid": {
                "description": "Interaction SID",
                "type": "string"
              },
              "type": {
                "description": "Channel type",
                "type": "string"
              },
              "status": {
                "description": "Channel status",
                "type": "string"
              }
            },
            "required": ["channelSid"],
            "additionalProperties": false
          },
          "description": "Channel details"
        }
      },
      "required": ["channels"],
      "additionalProperties": false
    }
  },
  "manage_interaction_participants": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["add", "remove", "list"],
          "description": "Action to perform"
        },
        "interactionSid": {
          "type": "string",
          "description": "Interaction SID"
        },
        "channelSid": {
          "type": "string",
          "description": "Channel SID within the interaction"
        },
        "participantSid": {
          "description": "Participant SID (required for remove)",
          "type": "string"
        },
        "participantType": {
          "description": "Type of participant to add",
          "type": "string",
          "enum": ["agent", "customer", "external", "supervisor", "unknown"]
        },
        "mediaProperties": {
          "description": "Media properties for the participant (e.g., {\"from\": \"+1234567890\"})",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "routingAttributes": {
          "description": "Routing attributes for agent participants",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["action", "interactionSid", "channelSid"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "participantSid": {
                "type": "string",
                "description": "Participant SID"
              },
              "type": {
                "description": "Participant type",
                "type": "string"
              },
              "interactionSid": {
                "description": "Interaction SID",
                "type": "string"
              },
              "channelSid": {
                "description": "Channel SID",
                "type": "string"
              }
            },
            "required": ["participantSid"],
            "additionalProperties": false
          },
          "description": "List of participants"
        }
      },
      "required": ["participants"],
      "additionalProperties": false
    }
  },
  "manage_workers": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "get", "update", "delete", "list"],
          "description": "Action to perform"
        },
        "workspaceSid": {
          "type": "string",
          "description": "Workspace SID"
        },
        "workerSid": {
          "description": "Worker SID (required for get/update/delete)",
          "type": "string"
        },
        "friendlyName": {
          "description": "Friendly name for the worker",
          "type": "string"
        },
        "activitySid": {
          "description": "Activity SID to set as current activity",
          "type": "string"
        },
        "attributes": {
          "description": "Worker attributes as JSON string",
          "type": "string"
        },
        "targetWorkersExpression": {
          "description": "Filter expression when listing workers (e.g., \"skills HAS 'support'\")",
          "type": "string"
        },
        "pageSize": {
          "description": "Number of results to return (max 1000)",
          "type": "number"
        }
      },
      "required": ["action", "workspaceSid"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workerSid": {
                "type": "string",
                "description": "Worker SID"
              },
              "friendlyName": {
                "description": "Friendly name",
                "type": "string"
              },
              "activityName": {
                "description": "Current activity name",
                "type": "string"
              },
              "available": {
                "description": "Whether the worker is available",
                "type": "boolean"
              },
              "attributes": {
                "description": "Worker attributes as JSON string",
                "type": "string"
              },
              "dateCreated": {
                "description": "Date created",
                "type": "string"
              },
              "dateUpdated": {
                "description": "Date last updated",
                "type": "string"
              }
            },
            "required": ["workerSid"],
            "additionalProperties": false
          },
          "description": "Worker records"
        }
      },
      "required": ["workers"],
      "additionalProperties": false
    }
  },
