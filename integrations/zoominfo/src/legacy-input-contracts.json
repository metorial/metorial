      },
      "signalScoreMin": {
        "description": "Minimum signal score",
        "type": "number"
      },
      "audienceStrengthMin": {
        "description": "Minimum audience strength",
        "type": "number"
      },
      "page": {
        "description": "Page number",
        "type": "number",
        "minimum": 1
      },
      "pageSize": {
        "description": "Results per page",
        "type": "number",
        "minimum": 1,
        "maximum": 100
      }
    },
    "additionalProperties": false
  },
  "enrich_intent": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
