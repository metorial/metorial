{
  "search_contacts": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "personId": {
        "description": "ZoomInfo person ID",
        "type": "string"
      },
      "emailAddress": {
        "description": "Email address to search for",
        "type": "string"
      },
      "firstName": {
        "description": "Contact first name",
        "type": "string"
      },
      "lastName": {
        "description": "Contact last name",
        "type": "string"
      },
      "fullName": {
        "description": "Contact full name",
        "type": "string"
      },
      "jobTitle": {
        "description": "Job title keyword (partial match)",
        "type": "string"
      },
      "managementLevel": {
        "description": "Management level (e.g., \"C-Level\", \"VP-Level\", \"Director\", \"Manager\")",
        "type": "string"
      },
      "department": {
        "description": "Department name",
        "type": "string"
      },
      "companyId": {
        "description": "ZoomInfo company ID",
        "type": "number"
      },
      "companyName": {
        "description": "Company name",
        "type": "string"
      },
      "companyWebsite": {
        "description": "Company website domain",
        "type": "string"
      },
      "country": {
        "description": "Country name or code",
        "type": "string"
      },
      "state": {
        "description": "State or province",
        "type": "string"
      },
      "city": {
        "description": "City name",
        "type": "string"
      },
      "contactAccuracyScoreMin": {
        "description": "Minimum contact accuracy score (70-99)",
        "type": "number",
        "minimum": 70,
        "maximum": 99
      },
      "page": {
        "description": "Page number (starts at 1)",
        "type": "number",
        "minimum": 1
      },
      "pageSize": {
        "description": "Results per page (1-100, default 25)",
        "type": "number",
        "minimum": 1,
        "maximum": 100
      },
      "sort": {
        "description": "Sort field (e.g., \"contactAccuracyScore\", \"-lastName\", \"companyName\")",
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "search_companies": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "companyName": {
        "description": "Company name to search for",
        "type": "string"
      },
      "companyId": {
        "description": "ZoomInfo company ID",
        "type": "number"
      },
      "companyWebsite": {
        "description": "Company website domain",
        "type": "string"
      },
      "country": {
        "description": "Country name or code",
        "type": "string"
      },
      "state": {
        "description": "State or province",
        "type": "string"
      },
      "city": {
        "description": "City name",
        "type": "string"
      },
      "zipCode": {
        "description": "ZIP/postal code",
        "type": "string"
      },
      "revenueMin": {
        "description": "Minimum annual revenue (in thousands USD)",
        "type": "number"
      },
      "revenueMax": {
        "description": "Maximum annual revenue (in thousands USD)",
        "type": "number"
      },
      "employeeRangeMin": {
        "description": "Minimum employee count",
        "type": "number"
      },
      "employeeRangeMax": {
        "description": "Maximum employee count",
        "type": "number"
      },
      "industryKeywords": {
        "description": "Industry keywords to filter by",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "companyType": {
        "description": "Company type (e.g., \"Public\", \"Private\", \"Government\")",
        "type": "string"
      },
      "companyTicker": {
        "description": "Stock ticker symbol",
        "type": "string"
      },
      "page": {
        "description": "Page number (starts at 1)",
        "type": "number",
        "minimum": 1
      },
      "pageSize": {
        "description": "Results per page (1-100, default 25)",
        "type": "number",
        "minimum": 1,
        "maximum": 100
      },
      "sort": {
        "description": "Sort field (e.g., \"name\", \"-employeeCount\", \"revenue\")",
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "enrich_contacts": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "matchBy": {
        "type": "string",
        "enum": ["personId", "email", "nameAndCompany"],
        "description": "How to match contacts: by ZoomInfo person ID, email address, or name+company combination"
      },
      "personIds": {
        "description": "ZoomInfo person IDs (when matchBy is \"personId\")",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "emailAddresses": {
        "description": "Email addresses to look up (when matchBy is \"email\")",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "contacts": {
        "description": "Contact records to match (when matchBy is \"nameAndCompany\")",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "firstName": {
              "type": "string"
            },
            "lastName": {
              "type": "string"
            },
            "companyName": {
              "type": "string"
            },
            "companyId": {
              "type": "number"
            },
            "jobTitle": {
              "type": "string"
            },
            "emailAddress": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "outputFields": {
        "description": "Specific fields to return (e.g., [\"firstName\", \"lastName\", \"email\", \"directPhoneNumber\", \"jobTitle\", \"companyName\"])",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["matchBy"],
    "additionalProperties": false
  },
  "enrich_companies": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "matchBy": {
        "type": "string",
        "enum": ["companyId", "domain", "name"],
        "description": "How to match companies: by ZoomInfo company ID, website domain, or company name"
      },
      "companyIds": {
        "description": "ZoomInfo company IDs (when matchBy is \"companyId\")",
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "domains": {
        "description": "Company website domains (when matchBy is \"domain\")",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "companyNames": {
        "description": "Company names (when matchBy is \"name\")",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "outputFields": {
        "description": "Specific fields to return (e.g., [\"companyName\", \"revenue\", \"employeeCount\", \"industry\", \"website\", \"city\", \"state\", \"country\"])",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["matchBy"],
    "additionalProperties": false
  },
  "search_intent": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
