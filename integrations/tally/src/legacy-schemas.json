    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "formId": {
          "type": "string",
          "description": "The form these questions belong to"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Unique question key identifier"
              },
              "label": {
                "type": "string",
                "description": "Human-readable question label"
              },
              "type": {
                "type": "string",
                "description": "Question type (e.g., INPUT_TEXT, INPUT_EMAIL, MULTIPLE_CHOICE)"
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          "description": "List of form questions"
        }
      },
      "required": ["formId", "questions"],
      "additionalProperties": false
    }
  },
