              },
              "label": {
                "type": "string",
                "description": "Human-readable field label"
              },
              "type": {
                "type": "string",
                "description": "Field type (e.g., INPUT_TEXT, INPUT_EMAIL, MULTIPLE_CHOICE)"
              },
              "value": {
                "description": "Submitted value"
              }
            },
            "required": ["key", "label", "type", "value"],
            "additionalProperties": false
          },
          "description": "Submitted field values"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Question key"
              },
              "label": {
                "type": "string",
                "description": "Question label"
              },
              "type": {
                "type": "string",
                "description": "Question type"
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          "description": "Form questions for context"
        }
      },
      "required": [
        "submissionId",
        "respondentId",
        "formId",
        "formName",
        "createdAt",
        "fields",
        "questions"
      ],
      "additionalProperties": false
    }
  },
  "delete_submission": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "formId": {
          "type": "string",
          "description": "The form ID the submission belongs to"
        },
        "submissionId": {
          "type": "string",
          "description": "The submission ID to delete"
        }
      },
      "required": ["formId", "submissionId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "formId": {
          "type": "string",
          "description": "Form the submission was deleted from"
        },
        "submissionId": {
          "type": "string",
          "description": "ID of the deleted submission"
        },
        "deleted": {
          "type": "boolean",
          "description": "Whether the deletion was successful"
        }
      },
      "required": ["formId", "submissionId", "deleted"],
      "additionalProperties": false
    }
  },
  "list_questions": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "formId": {
          "type": "string",
          "description": "The form ID to list questions for"
        }
      },
      "required": ["formId"],
