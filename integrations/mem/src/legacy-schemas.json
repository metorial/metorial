{
  "create_note": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "Markdown-formatted note content. The first line (e.g. \"# Title\") becomes the note title."
        },
        "noteId": {
          "description": "Optional custom UUID for the note.",
          "type": "string"
        },
        "collectionIds": {
          "description": "Collection IDs to assign the note to.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectionTitles": {
          "description": "Collection titles to assign the note to (case-insensitive exact match).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "description": "Custom creation timestamp in ISO 8601 format.",
          "type": "string"
        },
        "updatedAt": {
          "description": "Custom updated timestamp in ISO 8601 format.",
          "type": "string"
        }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "noteId": {
          "type": "string",
          "description": "Unique ID of the created note."
        },
        "title": {
          "type": "string",
          "description": "Title of the created note."
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full markdown content of the note."
        },
        "collectionIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of collections the note belongs to."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO 8601 format."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp in ISO 8601 format."
        }
      },
      "required": ["noteId", "title", "content", "collectionIds", "createdAt", "updatedAt"],
      "additionalProperties": false
    }
  },
  "get_note": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
