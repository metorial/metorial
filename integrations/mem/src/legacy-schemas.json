          "description": "The UUID of the note to retrieve."
        }
      },
      "required": ["noteId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "noteId": {
          "type": "string",
          "description": "Unique ID of the note."
        },
        "title": {
          "type": "string",
          "description": "Title of the note."
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full markdown content of the note."
        },
        "collectionIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of collections the note belongs to."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO 8601 format."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp in ISO 8601 format."
        }
      },
      "required": ["noteId", "title", "content", "collectionIds", "createdAt", "updatedAt"],
      "additionalProperties": false
    }
  },
  "list_notes": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "description": "Maximum number of notes to return (default: 50).",
          "type": "number"
        },
        "page": {
          "description": "Opaque cursor from a previous response for pagination.",
          "type": "string"
        },
        "orderBy": {
          "description": "Sort order field (default: updated_at).",
          "type": "string",
          "enum": ["created_at", "updated_at"]
        },
        "collectionId": {
          "description": "Filter to notes in a specific collection.",
          "type": "string"
        },
        "containsOpenTasks": {
          "description": "Filter to notes with open tasks.",
          "type": "boolean"
        },
        "containsTasks": {
          "description": "Filter to notes with any tasks.",
          "type": "boolean"
        },
        "containsImages": {
          "description": "Filter to notes with images.",
          "type": "boolean"
        },
        "containsFiles": {
          "description": "Filter to notes with file attachments.",
          "type": "boolean"
        },
        "includeNoteContent": {
          "description": "Include full markdown content in results (default: false).",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "noteId": {
                "type": "string",
                "description": "Unique ID of the note."
              },
              "title": {
                "type": "string",
                "description": "Title of the note."
              },
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Full markdown content (null unless includeNoteContent is true)."
              },
              "snippet": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Preview snippet of the note content."
              },
              "collectionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of collections the note belongs to."
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp in ISO 8601 format."
              },
              "updatedAt": {
                "type": "string",
                "description": "Last updated timestamp in ISO 8601 format."
              }
            },
            "required": [
              "noteId",
              "title",
              "content",
              "snippet",
              "collectionIds",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "description": "List of notes matching the filters."
        },
        "total": {
          "type": "number",
          "description": "Total number of notes matching the filters."
        },
        "nextPage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cursor for fetching the next page of results (null if no more pages)."
        }
      },
      "required": ["notes", "total", "nextPage"],
      "additionalProperties": false
    }
  },
  "search_notes": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "description": "Text query to search notes for.",
          "type": "string"
        },
        "filterByCollectionIds": {
          "description": "Only return notes belonging to these collections.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filterByContainsOpenTasks": {
          "description": "Only return notes with open tasks.",
          "type": "boolean"
        },
        "filterByContainsTasks": {
          "description": "Only return notes with any tasks.",
          "type": "boolean"
        },
        "filterByContainsImages": {
          "description": "Only return notes with images.",
          "type": "boolean"
        },
        "filterByContainsFiles": {
          "description": "Only return notes with file attachments.",
          "type": "boolean"
        },
        "includeNoteContent": {
          "description": "Include full markdown content in results (default: false).",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "noteId": {
                "type": "string",
                "description": "Unique ID of the note."
              },
              "title": {
                "type": "string",
                "description": "Title of the note."
              },
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Full markdown content (null unless includeNoteContent is true)."
              },
              "snippet": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Relevance snippet from the note content."
              },
              "collectionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of collections the note belongs to."
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp in ISO 8601 format."
              },
              "updatedAt": {
                "type": "string",
                "description": "Last updated timestamp in ISO 8601 format."
              }
            },
            "required": [
              "noteId",
              "title",
              "content",
              "snippet",
              "collectionIds",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "description": "Relevance-ranked list of matching notes."
        },
        "total": {
          "type": "number",
          "description": "Total number of matching notes."
        }
      },
      "required": ["notes", "total"],
      "additionalProperties": false
    }
  },
  "delete_note": {
