        "notifyOnDownload": {
          "description": "Notify on file downloads",
          "type": "boolean"
        },
        "notifyOnCopy": {
          "description": "Notify on file copies",
          "type": "boolean"
        },
        "notifyOnMove": {
          "description": "Notify on file moves",
          "type": "boolean"
        },
        "notifyOnDelete": {
          "description": "Notify on file deletes",
