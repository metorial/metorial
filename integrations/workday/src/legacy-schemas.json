  "action_inbox_task": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workerId": {
          "type": "string",
          "description": "The Workday worker ID who owns the inbox task"
        },
        "taskId": {
          "type": "string",
          "description": "The inbox task ID to act on"
        },
        "action": {
          "type": "string",
          "enum": ["approve", "deny"],
          "description": "Action to take on the task"
        },
        "comment": {
          "description": "Optional comment explaining the action",
          "type": "string"
        }
      },
      "required": ["workerId", "taskId", "action"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "description": "The inbox task ID that was acted upon"
        },
        "action": {
          "type": "string",
          "description": "The action that was taken"
        },
        "success": {
          "type": "boolean",
          "description": "Whether the action was successful"
        },
        "rawResponse": {
          "description": "Full API response"
        }
      },
      "required": ["taskId", "action", "success"],
      "additionalProperties": false
    }
  },
