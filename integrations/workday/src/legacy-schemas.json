            "properties": {
              "entryId": {
                "description": "Time-off entry ID",
                "type": "string"
              },
              "date": {
                "description": "Date of the time-off entry",
                "type": "string"
              },
              "dailyQuantity": {
                "description": "Number of hours for the day",
                "type": "number"
              },
              "timeOffType": {
                "description": "Type of time off",
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Workday ID",
                    "type": "string"
                  },
                  "descriptor": {
                    "description": "Display name",
                    "type": "string"
                  },
                  "href": {
                    "description": "API href",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "worker": {
                "description": "Worker reference",
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Workday ID",
                    "type": "string"
                  },
                  "descriptor": {
                    "description": "Display name",
                    "type": "string"
                  },
                  "href": {
                    "description": "API href",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "status": {
                "description": "Entry status",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "description": "List of time-off entries"
        },
        "total": {
          "type": "number",
          "description": "Total number of matching entries"
        }
      },
      "required": ["entries", "total"],
      "additionalProperties": false
    }
