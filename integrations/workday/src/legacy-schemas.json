{
  "list_workers": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "search": {
          "description": "Search term to filter workers by name or other attributes",
          "type": "string"
        },
        "limit": {
          "description": "Maximum number of results to return (default: 20)",
          "type": "number"
        },
        "offset": {
          "description": "Number of results to skip for pagination (default: 0)",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workerId": {
                "type": "string",
                "description": "Unique worker ID"
              },
              "displayName": {
                "type": "string",
                "description": "Worker display name"
              },
              "href": {
                "description": "API href for this worker",
                "type": "string"
              },
              "primaryWorkEmail": {
                "description": "Primary work email address",
                "type": "string"
              },
              "businessTitle": {
                "description": "Business title",
                "type": "string"
              },
              "supervisoryOrganization": {
                "description": "Primary supervisory organization",
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Workday ID of the referenced object",
                    "type": "string"
                  },
                  "descriptor": {
                    "description": "Display name of the referenced object",
                    "type": "string"
                  },
                  "href": {
                    "description": "API href for the referenced object",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["workerId", "displayName"],
            "additionalProperties": false
          },
          "description": "List of workers"
        },
        "total": {
          "type": "number",
          "description": "Total number of matching workers"
        }
      },
      "required": ["workers", "total"],
      "additionalProperties": false
    }
  },
