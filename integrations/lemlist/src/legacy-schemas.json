{
  "list_campaigns": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "description": "Filter campaigns by status",
          "type": "string",
          "enum": ["running", "draft", "archived", "ended", "paused", "errors"]
        },
        "offset": {
          "description": "Pagination offset",
          "type": "number"
        },
        "limit": {
          "description": "Number of results per page (max 100)",
          "type": "number"
        },
        "sortOrder": {
          "description": "Sort order by creation date",
          "type": "string",
          "enum": ["asc", "desc"]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaigns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "campaignId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "hasError": {
                "type": "boolean"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["campaignId"],
            "additionalProperties": false
          }
        }
      },
      "required": ["campaigns"],
      "additionalProperties": false
    }
  },
  "get_campaign": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "description": "The ID of the campaign to retrieve"
        }
      },
      "required": ["campaignId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "hasError": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sequenceId": {
          "type": "string"
        },
        "scheduleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "senders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "senderId": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["campaignId"],
      "additionalProperties": false
    }
  },
  "create_campaign": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
