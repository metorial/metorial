  "update_campaign": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "description": "The ID of the campaign to update"
        },
        "action": {
          "description": "Start or pause the campaign",
          "type": "string",
          "enum": ["start", "pause"]
        },
        "name": {
          "description": "New campaign name",
          "type": "string"
        },
        "stopOnEmailReplied": {
          "description": "Stop outreach when a lead replies to an email",
          "type": "boolean"
        },
        "stopOnMeetingBooked": {
          "description": "Stop outreach when a meeting is booked",
          "type": "boolean"
        },
        "stopOnLinkClicked": {
          "description": "Stop outreach when a link is clicked",
          "type": "boolean"
        },
        "autoLeadInterest": {
          "description": "Automatically mark leads as interested",
          "type": "boolean"
        },
        "disableTrackOpen": {
          "description": "Disable open tracking",
          "type": "boolean"
        },
        "disableTrackClick": {
          "description": "Disable click tracking",
          "type": "boolean"
        },
        "disableTrackReply": {
          "description": "Disable reply tracking",
          "type": "boolean"
        }
      },
      "required": ["campaignId"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": ["campaignId"],
      "additionalProperties": false
    }
  },
  "get_campaign_stats": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "description": "The ID of the campaign"
        },
        "startDate": {
          "type": "string",
          "description": "Start date in ISO 8601 format (e.g., 2024-01-01T00:00:00.000Z)"
        },
        "endDate": {
          "type": "string",
          "description": "End date in ISO 8601 format (e.g., 2024-12-31T23:59:59.999Z)"
        },
        "channels": {
          "description": "Filter stats by channels",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["email", "linkedin", "others"]
          }
        }
      },
      "required": ["campaignId", "startDate", "endDate"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
