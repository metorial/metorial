          "type": "number"
        },
        "leadsReached": {
          "type": "number"
        },
        "leadsOpened": {
          "type": "number"
        },
        "leadsClicked": {
          "type": "number"
        },
        "leadsReplied": {
          "type": "number"
        },
        "leadsInterested": {
          "type": "number"
        },
        "leadsNotInterested": {
          "type": "number"
        },
        "leadsUnsubscribed": {
          "type": "number"
        },
        "messagesSent": {
          "type": "number"
        },
        "messagesNotSent": {
          "type": "number"
        },
        "messagesBounced": {
          "type": "number"
        },
        "delivered": {
          "type": "number"
        },
        "opened": {
          "type": "number"
        },
        "clicked": {
          "type": "number"
        },
        "replied": {
          "type": "number"
        },
        "meetingBooked": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
