      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sequenceId": {
          "type": "string"
        },
        "scheduleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "type": "string"
        }
