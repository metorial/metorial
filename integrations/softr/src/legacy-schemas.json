{
  "create_user": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full name of the user"
        },
        "email": {
          "type": "string",
          "description": "Email address of the user"
        },
        "password": {
          "description": "Password for the user. If omitted, Softr auto-generates one.",
          "type": "string"
        },
        "generateMagicLink": {
          "description": "Whether to generate a magic link for passwordless login",
          "type": "boolean"
        }
      },
      "required": ["fullName", "email"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email of the created user"
        },
        "magicLink": {
          "description": "Generated magic link URL, if requested",
          "type": "string"
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  },
  "delete_user": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the user to delete"
        }
      },
      "required": ["email"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email of the deleted user"
        },
        "deleted": {
          "type": "boolean",
          "description": "Whether the deletion was successful"
        }
      },
      "required": ["email", "deleted"],
      "additionalProperties": false
    }
  },
  "generate_magic_link": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the user to generate a magic link for"
        }
      },
      "required": ["email"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email of the user"
        },
        "magicLink": {
          "type": "string",
          "description": "Generated magic link URL"
        }
      },
      "required": ["email", "magicLink"],
      "additionalProperties": false
    }
  },
  "sync_users": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "emails": {
          "description": "Optional list of email addresses to sync. If omitted, all users are synced.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "synced": {
          "type": "boolean",
          "description": "Whether the sync was triggered successfully"
        },
        "scope": {
          "type": "string",
          "description": "Whether all users or specific users were synced"
        }
      },
      "required": ["synced", "scope"],
      "additionalProperties": false
    }
  },
  "validate_user_token": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "jwt": {
          "type": "string",
          "description": "The JWT token to validate"
        }
      },
      "required": ["jwt"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean",
          "description": "Whether the token is valid"
        },
        "user": {
          "description": "User data extracted from the token, if valid",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["valid"],
      "additionalProperties": false
    }
  },
  "list_databases": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "databaseId": {
                "type": "string",
                "description": "Unique identifier of the database"
              },
              "name": {
                "type": "string",
                "description": "Name of the database"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Description of the database"
              },
              "workspaceId": {
                "type": "string",
                "description": "ID of the workspace the database belongs to"
              },
              "tablesCount": {
                "type": "number",
                "description": "Number of tables in the database"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp"
              },
              "updatedAt": {
                "type": "string",
                "description": "Last update timestamp"
              }
            },
            "required": [
              "databaseId",
              "name",
              "description",
              "workspaceId",
              "tablesCount",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "description": "List of accessible databases"
        }
      },
      "required": ["databases"],
      "additionalProperties": false
    }
  },
  "manage_database": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databaseId": {
          "description": "ID of the database (required for get/update/delete)",
          "type": "string"
        },
        "workspaceId": {
          "description": "Workspace ID (required for creating a new database)",
          "type": "string"
        },
        "name": {
          "description": "Name of the database (required for create, optional for update)",
          "type": "string"
        },
        "description": {
          "description": "Description of the database",
          "type": "string"
        },
        "delete": {
          "description": "Set to true to delete the database",
          "type": "boolean"
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "database": {
          "description": "Database details (not returned on delete)",
          "type": "object",
          "properties": {
            "databaseId": {
              "type": "string",
              "description": "Unique identifier of the database"
            },
            "name": {
              "type": "string",
              "description": "Name of the database"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Description of the database"
            },
            "workspaceId": {
              "type": "string",
              "description": "ID of the workspace"
            },
            "tablesCount": {
              "type": "number",
              "description": "Number of tables in the database"
            },
            "createdAt": {
              "type": "string",
              "description": "Creation timestamp"
            },
            "updatedAt": {
              "type": "string",
              "description": "Last update timestamp"
            }
          },
          "required": [
            "databaseId",
            "name",
            "description",
            "workspaceId",
            "tablesCount",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "deleted": {
          "description": "True if database was deleted",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "list_tables": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databaseId": {
          "type": "string",
          "description": "ID of the database to list tables from"
        }
      },
      "required": ["databaseId"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tableId": {
                "type": "string",
                "description": "Unique table identifier"
              },
              "name": {
                "type": "string",
                "description": "Table name"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Table description"
              },
              "primaryFieldId": {
                "type": "string",
                "description": "ID of the primary field"
              },
              "defaultViewId": {
                "type": "string",
                "description": "ID of the default view"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fieldId": {
                      "type": "string",
                      "description": "Unique field identifier"
                    },
                    "name": {
                      "type": "string",
                      "description": "Field name"
                    },
                    "type": {
                      "type": "string",
                      "description": "Field type (e.g., SINGLE_LINE_TEXT, NUMBER, EMAIL, etc.)"
                    },
                    "description": {
                      "description": "Field description",
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "required": {
                      "description": "Whether the field is required",
                      "type": "boolean"
                    },
                    "readonly": {
                      "description": "Whether the field is read-only",
                      "type": "boolean"
                    }
                  },
                  "required": ["fieldId", "name", "type"],
                  "additionalProperties": false
                },
                "description": "Fields (columns) defined on the table"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp"
              },
              "updatedAt": {
                "type": "string",
                "description": "Last update timestamp"
              }
            },
            "required": [
              "tableId",
              "name",
              "description",
              "primaryFieldId",
              "defaultViewId",
              "fields",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "description": "List of tables in the database"
        }
      },
      "required": ["tables"],
      "additionalProperties": false
    }
  },
  "manage_table": {
