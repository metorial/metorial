        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["recordId", "tableId", "fields", "createdAt", "updatedAt"],
      "additionalProperties": false
    }
  },
