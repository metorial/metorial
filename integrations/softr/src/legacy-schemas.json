          },
          "additionalProperties": {},
          "description": "Updated field values"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["recordId", "tableId", "fields", "createdAt", "updatedAt"],
      "additionalProperties": false
    }
  },
  "delete_record": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databaseId": {
          "type": "string",
          "description": "ID of the database"
        },
        "tableId": {
          "type": "string",
          "description": "ID of the table"
        },
        "recordId": {
          "type": "string",
          "description": "ID of the record to delete"
        }
      },
      "required": ["databaseId", "tableId", "recordId"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "description": "ID of the deleted record"
        },
        "deleted": {
          "type": "boolean",
          "description": "Whether the deletion was successful"
        }
      },
      "required": ["recordId", "deleted"],
      "additionalProperties": false
    }
  },
  "search_records": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databaseId": {
          "type": "string",
          "description": "ID of the database"
        },
        "tableId": {
          "type": "string",
          "description": "ID of the table to search"
        },
        "filter": {
          "description": "Filter conditions for the search",
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": ["condition"]
        },
        "sort": {
          "description": "Sorting rules",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sortingField": {
                "type": "string",
                "description": "Field ID to sort by"
              },
              "sortType": {
                "type": "string",
                "enum": ["ASC", "DESC"],
                "description": "Sort direction"
              }
            },
            "required": ["sortingField", "sortType"]
          }
        },
        "offset": {
          "description": "Number of records to skip (default 0)",
          "type": "number"
        },
        "limit": {
          "description": "Maximum records to return (default 50, max 200)",
          "type": "number"
        },
        "fieldNames": {
          "description": "Use field names instead of IDs as keys in the response",
          "type": "boolean"
        }
      },
      "required": ["databaseId", "tableId"],
      "$defs": {
        "__schema0": {
          "type": "object",
          "properties": {
            "operator": {
              "type": "string",
              "description": "Filter operator (e.g., IS, IS_NOT, CONTAINS, GREATER_THAN, IS_EMPTY, AND, OR, IS_BETWEEN, etc.)"
            },
            "field": {
              "description": "Field ID to filter on (for binary/unary operators)",
              "type": "string"
            },
            "value": {
              "description": "Value to compare against (for binary operators)"
            },
            "values": {
              "description": "Array of values (for IS_ONE_OF, IS_NOT_ONE_OF, HAS_ANY_OF, etc.)",
              "type": "array",
              "items": {}
            },
            "conditions": {
              "description": "Nested conditions (for AND/OR composite operators)",
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": ["operator"]
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recordId": {
                "type": "string",
                "description": "Unique record identifier"
              },
              "tableId": {
                "type": "string",
                "description": "Table the record belongs to"
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "Field values"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp"
              },
              "updatedAt": {
                "type": "string",
                "description": "Last update timestamp"
              }
            },
            "required": ["recordId", "tableId", "fields", "createdAt", "updatedAt"],
            "additionalProperties": false
          },
          "description": "Matching records"
        },
        "total": {
          "description": "Total number of matching records",
          "type": "number"
        },
        "offset": {
          "description": "Current offset",
          "type": "number"
        },
        "limit": {
          "description": "Current limit",
          "type": "number"
        }
      },
      "required": ["records"],
      "additionalProperties": false
    }
  }
}
