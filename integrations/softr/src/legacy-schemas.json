  "manage_table_field": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databaseId": {
          "type": "string",
          "description": "ID of the database"
        },
        "tableId": {
          "type": "string",
          "description": "ID of the table"
        },
        "fieldId": {
          "description": "ID of the field (required for get/update/delete)",
          "type": "string"
        },
        "name": {
          "description": "Field name (required for add)",
          "type": "string"
        },
        "type": {
          "description": "Field type (required for add)",
          "type": "string"
        },
        "options": {
          "description": "Type-specific configuration options",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "description": {
          "description": "Field description (for add)",
          "type": "string"
        },
        "allowMultipleEntries": {
          "description": "Whether to allow multiple entries (for add)",
          "type": "boolean"
        },
        "required": {
          "description": "Whether the field is required (for add)",
          "type": "boolean"
        },
        "defaultValue": {
          "description": "Default value (for add)",
          "type": "string"
        },
        "delete": {
          "description": "Set to true to delete the field",
          "type": "boolean"
        }
      },
      "required": ["databaseId", "tableId"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "field": {
          "description": "Field details (not returned on delete)",
          "type": "object",
          "properties": {
            "fieldId": {
              "type": "string",
              "description": "Unique field identifier"
            },
            "name": {
              "type": "string",
              "description": "Field name"
            },
            "type": {
              "type": "string",
              "description": "Field type"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Field description"
            },
            "allowMultipleEntries": {
              "description": "Whether multiple entries are allowed",
              "type": "boolean"
            },
            "readonly": {
              "description": "Whether the field is read-only",
              "type": "boolean"
            },
            "required": {
              "description": "Whether the field is required",
              "type": "boolean"
            },
            "locked": {
              "description": "Whether the field is locked",
              "type": "boolean"
            },
            "defaultValue": {
              "description": "Default value for the field",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string",
              "description": "Creation timestamp"
            },
            "updatedAt": {
              "type": "string",
              "description": "Last update timestamp"
            }
          },
          "required": ["fieldId", "name", "type", "description", "createdAt", "updatedAt"],
          "additionalProperties": false
        },
        "deleted": {
          "description": "True if field was deleted",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "get_records": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "databaseId": {
          "type": "string",
          "description": "ID of the database"
        },
        "tableId": {
          "type": "string",
          "description": "ID of the table"
        },
        "recordId": {
          "description": "Specific record ID to retrieve. If omitted, lists records.",
          "type": "string"
        },
        "offset": {
          "description": "Number of records to skip (for pagination, default 0)",
          "type": "number"
        },
        "limit": {
          "description": "Maximum number of records to return (default 10, max 200)",
          "type": "number"
        },
        "fieldNames": {
          "description": "Use field names instead of IDs as keys in the response",
          "type": "boolean"
        },
        "viewId": {
          "description": "Filter records by a specific view",
          "type": "string"
        }
      },
      "required": ["databaseId", "tableId"]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "records": {
          "description": "List of records (when listing)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recordId": {
                "type": "string",
                "description": "Unique record identifier"
              },
              "tableId": {
                "type": "string",
                "description": "Table the record belongs to"
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "Field values of the record (keyed by field ID or name)"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation timestamp"
              },
              "updatedAt": {
                "type": "string",
                "description": "Last update timestamp"
              }
            },
            "required": ["recordId", "tableId", "fields", "createdAt", "updatedAt"],
            "additionalProperties": false
          }
        },
        "record": {
          "description": "Single record (when fetching by ID)",
          "type": "object",
          "properties": {
            "recordId": {
              "type": "string",
              "description": "Unique record identifier"
            },
            "tableId": {
              "type": "string",
              "description": "Table the record belongs to"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Field values of the record (keyed by field ID or name)"
            },
            "createdAt": {
              "type": "string",
              "description": "Creation timestamp"
            },
            "updatedAt": {
              "type": "string",
              "description": "Last update timestamp"
            }
          },
          "required": ["recordId", "tableId", "fields", "createdAt", "updatedAt"],
          "additionalProperties": false
        },
        "total": {
          "description": "Total number of records in the table",
          "type": "number"
        },
        "offset": {
          "description": "Current offset",
          "type": "number"
        },
        "limit": {
          "description": "Current limit",
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
