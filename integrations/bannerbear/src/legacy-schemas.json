  "create_editor_session": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "templateUid": {
          "type": "string",
          "description": "UID of the template to open in the editor"
        },
        "mode": {
          "description": "Editor mode: default (full editing), limited (no add/delete layers), or preview (read-only)",
          "type": "string",
          "enum": ["default", "limited", "preview"]
        },
        "metadata": {
          "description": "Custom metadata to attach to the session",
          "type": "string"
        },
        "customFonts": {
          "description": "List of custom font URLs to make available in the editor",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["templateUid"],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionUid": {
          "type": "string",
          "description": "UID of the editor session"
        },
        "editorUrl": {
          "type": "string",
          "description": "URL to access the template editor (expires in 2 hours)"
        },
        "templateUid": {
          "type": "string",
          "description": "UID of the template being edited"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Editor mode"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the session was created"
        }
      },
      "required": ["sessionUid", "editorUrl", "templateUid", "mode", "createdAt"],
      "additionalProperties": false
    }
  },
  "create_signed_url": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
